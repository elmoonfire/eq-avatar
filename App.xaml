<Application x:Class="EQAvatar.Spike.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <!-- A tiny dark palette so the spike doesn't look like a 1998 dialog. -->
        <SolidColorBrush x:Key="Bg" Color="#101317"/>
        <SolidColorBrush x:Key="Panel" Color="#191E25"/>
        <SolidColorBrush x:Key="Accent" Color="#4FC3F7"/>
        <SolidColorBrush x:Key="AccentDim" Color="#2A4A57"/>
        <SolidColorBrush x:Key="Text" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextDim" Color="#9AA7B4"/>
        <SolidColorBrush x:Key="Good" Color="#7CE38B"/>
        <SolidColorBrush x:Key="Warn" Color="#FFCB6B"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentDim}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C0F13"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDim}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Custom tooltip: light blue, white text, no border, user-adjustable opacity.
             (The default was dark text on a near-white bg — unreadable on this theme.) -->
        <sys:Double x:Key="TooltipOpacity">0.92</sys:Double>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border CornerRadius="8" Padding="10,7" Background="#4FB4EE"
                                Opacity="{DynamicResource TooltipOpacity}" MaxWidth="360">
                            <ContentPresenter TextElement.Foreground="#FFFFFF"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Readable dark tabs (the default chrome washed out on the dark theme). -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Background="#141C26" BorderBrush="#2A4A57"
                                BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" Margin="0,0,4,0" Padding="14,8">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="#C6D2DE" TextElement.FontSize="13"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="#20303F"/>
                                <Setter TargetName="tab" Property="BorderBrush" Value="#4FC3F7"/>
                                <Setter TargetName="tab" Property="BorderThickness" Value="1,2,1,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tab" Property="Background" Value="#26384A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
