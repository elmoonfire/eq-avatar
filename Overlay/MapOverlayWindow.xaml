<Window x:Class="EQAvatar.Spike.Overlay.MapOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:EQAvatar.Spike.Map"
        Title="EQ Avatar — Map Overlay"
        Width="460" Height="500" MinWidth="280" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">

    <Border CornerRadius="14" BorderThickness="1.5" BorderBrush="#664FC3F7">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#D9101821" Offset="0"/>
                <GradientStop Color="#D90B0F14" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: drag + title (interactive only while click-through is OFF) -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="#204FC3F7" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_Drag" Padding="12,8">
                <Grid>
                    <TextBlock x:Name="TitleLabel" Text="◈  ZONE MAP" FontWeight="Bold" Foreground="#CFE9F7"
                               FontFamily="Consolas" FontSize="13"/>
                    <TextBlock x:Name="ClickThroughTag" Text="interactive" HorizontalAlignment="Right"
                               Foreground="#9AA7B4" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- The REAL zone map — same element as the Maps page (walls, heat, trail, marker) -->
            <Border Grid.Row="1" Margin="8" CornerRadius="10" ClipToBounds="True" Background="#0B121E">
                <map:MapViewElement x:Name="OverlayMap"/>
            </Border>

            <!-- Footer: loc + controls -->
            <Grid Grid.Row="2" Margin="12,0,12,10">
                <TextBlock x:Name="CoordLabel" Text="overlay follows the Maps page" Foreground="#9AA7B4"
                           FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="fit" Click="Fit_Click" Padding="8,2" Margin="0,0,6,0"/>
                    <Button Content="ghost" Click="Grab_Click" Padding="8,2" Margin="0,0,6,0"
                            ToolTip="Toggle click-through: mouse goes straight to the game beneath. Turn it back off from the app (close + reopen the overlay)."/>
                    <Button Content="close" Click="Close_Click" Padding="8,2"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
