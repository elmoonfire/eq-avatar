<Window x:Class="EQAvatar.Spike.Launch.LaunchMethodPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQ Avatar — Launch Method" Width="840" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Border CornerRadius="16" Background="#0E141B" BorderBrush="#2A4A57" BorderThickness="1">
        <DockPanel Margin="24">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Choose how EQ Avatar launches and controls the game"
                           FontSize="19" FontWeight="Bold" Foreground="#E6EDF3"/>
                <TextBlock x:Name="Subtitle" Foreground="#9AA7B4" Margin="0,4,0,0"
                           Text="Pick the one that fits your comfort with risk and setup. You can switch anytime with the Launch Method button."/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Cancel" HorizontalAlignment="Right" Margin="0,14,0,0"
                    Padding="14,6" Click="Cancel_Click" Background="#141C26" Foreground="#9AA7B4" BorderBrush="#2A4A57"/>
            <UniformGrid x:Name="CardHost" Rows="2" Columns="2"/>
        </DockPanel>
    </Border>
</Window>
