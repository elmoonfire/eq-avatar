<Window x:Class="EQAvatar.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:map="clr-namespace:EQAvatar.Spike.Map"
        xmlns:charts="clr-namespace:EQAvatar.Spike.Charts"
        Title="EQ Avatar" Height="720" Width="1060" MinHeight="560" MinWidth="900"
        WindowStyle="None" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- left-nav item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B9C6D4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="10,9">
                            <Grid>
                                <Rectangle x:Name="bar" Width="3" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}"
                                           HorizontalAlignment="Left" Margin="-7,3,0,3" Opacity="0"/>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#204FC3F7"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#EAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#8FA0B2"/>
        </Style>

        <Style x:Key="RailCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5D6878"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,4,0,6"/>
        </Style>

        <!-- content card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#262D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- window caption buttons -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FB0C2"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A3242" BorderThickness="1" Background="{StaticResource Bg}">
        <DockPanel>

            <!-- ===================== TITLE BAR ===================== -->
            <Grid DockPanel.Dock="Top" Height="52" Background="#141926">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="20" Height="20" Margin="0,0,10,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.38,0.32" Center="0.38,0.32" RadiusX="0.85" RadiusY="0.85">
                                <GradientStop Color="#EAF9FF" Offset="0"/>
                                <GradientStop Color="#4FC3F7" Offset="0.55"/>
                                <GradientStop Color="#17607E" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="EQ · AVATAR" FontWeight="Bold" FontSize="13" Foreground="#DBE6F2"/>
                </StackPanel>

                <!-- transient "settings saved" toast (fades out) -->
                <Border x:Name="SavedToast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#12261B" BorderBrush="#2C8C55" BorderThickness="1" CornerRadius="20" Padding="14,5"
                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#7CE38B" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SavedToastText" Text="Settings saved" Foreground="#B6F2C9" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- character profile chip -->
                <Border Grid.Column="2" x:Name="Chip" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                        Background="#0E1420" BorderBrush="#2F3849" BorderThickness="1" CornerRadius="30" Padding="6,4,12,4"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="Chip_Click"
                        ToolTip="Open Licensing">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E879F9" Offset="0"/>
                                    <GradientStop Color="#4FC3F7" Offset="0.5"/>
                                    <GradientStop Color="#7CE38B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#0D141D">
                                <TextBlock x:Name="ChipAvatar" Text="?" FontWeight="Bold" Foreground="#EAF3FF" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChipDot" Width="8" Height="8" Fill="#5D6878" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChipName" Text="Not signed in" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="ChipSub" Text="Licensing → set your name" Foreground="{StaticResource TextDim}" FontSize="11"/>
                        </StackPanel>
                        <Border x:Name="ChipTierBadge" CornerRadius="20" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="ChipTierText" Text="" FontWeight="Bold" FontSize="10" Foreground="#0B0F16"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- window controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinBtn}" Click="TitleMin_Click" Content="&#xE921;" ToolTip="Minimize"/>
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Click="TitleMax_Click" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button Style="{StaticResource WinBtnClose}" Click="TitleClose_Click" Content="&#xE8BB;" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===================== BODY ===================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT NAV RAIL -->
                <Border Grid.Column="0" Background="#10141D" BorderBrush="#20262F" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,12,10,10">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Content="Launch Method" Click="LaunchMethod_Click" HorizontalAlignment="Stretch" Margin="0,8,0,4"/>
                            <TextBlock x:Name="LaunchMethodLabel" Text="method: not set" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,0"/>
                            <!-- Ambient update chip (Companion-style): one calm line normally, a hairline
                                 bar while downloading, and a single gold "Restart to update" when a build is
                                 staged. It glows once on arrival, then rests. No popups, ever. -->
                            <Border x:Name="UpdaterChip" Margin="0,8,0,2" CornerRadius="6" Padding="10,6"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="UpdaterChip_Click" ToolTip="Click to check for updates">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="UpdaterChipIcon" Text="⟳" FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Foreground="#D9B25F" Visibility="Collapsed"/>
                                        <TextBlock x:Name="UpdaterChipText" Text="not checked yet" Foreground="{StaticResource TextDim}"
                                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdaterChipSub" Text="" Foreground="#E6C879" FontSize="10"
                                               FontFamily="Consolas" Margin="18,1,0,0" Visibility="Collapsed"/>
                                    <ProgressBar x:Name="UpdaterChipBar" Height="2" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                 Value="0" Background="#1AFFFFFF" Foreground="#D9B25F" BorderThickness="0"
                                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="2,6,0,0" Foreground="#5D6878" FontSize="11">
                                <Run Text="EQ Avatar"/> <Run x:Name="VersionRun" Text="v0.9.1"/></TextBlock>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource RailCap}" Text="COMMAND"/>
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelHome" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/><TextBlock Text="Command Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGrind" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelGrind" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE72C;"/><TextBlock Text="Grind"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFollower" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelFollower" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE716;"/><TextBlock Text="Follower"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMouse" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelMouse" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE962;"/><TextBlock Text="Mouse Motion"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="INSIGHT" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavCombat" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelCombat" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C1;"/><TextBlock Text="Combat"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMaps" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelMaps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE909;"/><TextBlock Text="Maps"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavData" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelData" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE82D;"/><TextBlock Text="Game Data"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSessions" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelSessions" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE81C;"/><TextBlock Text="Sessions"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLog" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C3;"/><TextBlock Text="Log Reader"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="DEBUG" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelInput" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE765;"/><TextBlock Text="Input Probe"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLogin" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLogin" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE77B;"/><TextBlock Text="Login Console"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="ACCOUNT" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavLicensing" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLicensing" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE72E;"/><TextBlock Text="Licensing"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelSettings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/><TextBlock Text="Settings"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CONTENT AREA (panels overlap; one visible at a time) -->
                <Grid Grid.Column="1">

                    <!-- ===== COMMAND CENTER (home) ===== -->
                    <Grid x:Name="PanelHome">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,20,22,22">

                                <!-- ===== LAUNCH HERO (mascot + one-click launch) ===== -->
                                <Border Margin="0,0,0,16" CornerRadius="14" BorderBrush="#26405A" BorderThickness="1" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#13243B" Offset="0"/>
                                            <GradientStop Color="#0E1A2A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="132" Height="150" Margin="8,0,0,0">
                                            <Ellipse Width="118" Height="118" Opacity="0.20" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#004FC3F7" Offset="1"/></RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Image x:Name="MascotImg" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,18,18,18" VerticalAlignment="Center">
                                            <TextBlock Text="Ready when you are." FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
                                            <TextBlock x:Name="LaunchStatus" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,12"
                                                       Text="One click launches EverQuest, clicks the green Play, picks your server, and takes you to Enter World. Progress streams into the Login Console."/>
                                            <WrapPanel>
                                                <Button Content="▶  Launch Game" Click="LaunchGame_Click" FontWeight="Bold" Padding="18,9" Margin="0,0,10,6"/>
                                                <Button Content="Login Console →" Click="HomeGoLogin_Click" Margin="0,0,10,6"/>
                                                <Button Content="Set launcher…" Click="PickLauncher_Click" Margin="0,0,10,6"/>
                                                <CheckBox x:Name="TopmostBox" Content="Stay on top (except the game)" IsChecked="True" Click="TopmostBox_Click"
                                                          Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Command Center" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="Everything your character is doing right now, at a glance." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#10261B" BorderBrush="#275C3C" BorderThickness="1" CornerRadius="30" Padding="12,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HomeStatusDot" Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HomeStatusPill" Text="Idle" Foreground="#B6F2C9" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Rows="1" Columns="4">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="SESSION" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeSession" Text="0m" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="KILLS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeKills" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="XP TICKS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeXp" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="ACTIONS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeActions" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="DAMAGE — LAST 10 MIN" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeDpsLabel" Grid.Column="1" Text="0 DPS" FontSize="11" Foreground="#7CE38B" FontWeight="SemiBold"/>
                                        </Grid>
                                        <charts:TimeSeriesChart x:Name="HomeDpsChart" Height="120" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="THIS SESSION" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Role" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeRole" Grid.Column="1" Text="Idle"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Target" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeTarget" Grid.Column="1" Text="no target set"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Panic stop" Foreground="{StaticResource TextDim}"/><TextBlock Grid.Column="1" Text="F12 (works in-game)"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ACCOUNT" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Character" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeChar" Grid.Column="1" Text="—"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tier" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeTier" Grid.Column="1" Text="not checked in"/></Grid>
                                            <Button Content="Open dashboard" Click="OpenDashboard_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="6,12,0,0">
                                    <Button Content="Go to Grind" Click="HomeGoGrind_Click"/>
                                    <Button Content="Maps &amp; heat" Click="HomeGoHeat_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== LOG READER ===== -->
                    <Grid x:Name="PanelLog" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log folder" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogFolderBox" Grid.Column="1" Text="G:\EQ\Logs"/>
                            <Button Grid.Column="2" Content="Browse…" Click="BrowseLogFolder_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="eqclient.ini" VerticalAlignment="Center"/>
                            <TextBox x:Name="IniPathBox" Grid.Column="1" Text="G:\EQ\eqclient.ini"/>
                            <Button Grid.Column="2" Content="Browse…" Click="BrowseIni_Click"/>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button Content="Find newest log" Click="FindNewest_Click"/>
                            <Button Content="Ensure Log=1" Click="EnsureLog_Click"/>
                            <Button Content="Read whole file" Click="ReadAll_Click"/>
                            <Button Content="Live tail" Click="Tail_Click"/>
                            <Button Content="Stop" Click="StopTail_Click"/>
                            <Button Content="Clear" Click="ClearLog_Click"/>
                        </WrapPanel>

                        <ListBox x:Name="LogList" Grid.Row="3" Background="#0C0F13"
                                 BorderBrush="{StaticResource AccentDim}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="◈ Location lines seen: " Foreground="{StaticResource TextDim}"/>
                            <TextBlock x:Name="LocCount" Text="0" Foreground="{StaticResource Good}" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusLog" Margin="20,0,0,0" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== INPUT PROBE ===== -->
                    <Grid x:Name="PanelInput" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="ElevBorder" Grid.Row="0" Background="#33FFCB6B" BorderBrush="#FFCB6B"
                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock x:Name="ElevBanner" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Checking elevation…"/>
                                <Button Content="Relaunch as administrator" Click="RelaunchAdmin_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                                   Text="These are diagnostics. EQL only accepts input while it is the FOCUSED window — so clicking a button here sends while this app has focus, which is exactly why nothing seemed to happen. Two ways around it: keep 'give me 3s to click into EQ' checked and each button counts down so you can click into the game first; OR with EQ focused, press Ctrl+Alt+F9 to re-fire the last action. For real automation, use the Grind panel — it only fires while EQ is focused and auto-pauses when you tab away, so it just works. Run as administrator if EQL is elevated."/>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                            <Button Content="Refresh window list" Click="RefreshWindows_Click"/>
                            <Button Content="Guess EverQuest" Click="GuessEq_Click"/>
                            <Button Content="List child windows →" Click="ListChildren_Click"/>
                            <TextBlock Text="Key:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <TextBox x:Name="KeyBox" Text="1" Width="42" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ExtendedBox" Content="extended key" Foreground="{StaticResource TextDim}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </WrapPanel>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock DockPanel.Dock="Top" Text="Top-level windows" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"/>
                                <ListBox x:Name="WinList" Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Child controls (of selected window)" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"/>
                                <ListBox x:Name="ChildList" Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </DockPanel>
                        </Grid>

                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <CheckBox x:Name="ProbeCountdownBox" Content="give me 3s to click into EQ" IsChecked="True"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,8"/>
                            <Button Content="PostMessage → target" Click="PostTarget_Click"/>
                            <Button Content="SendMessage → target" Click="SendMsgTarget_Click"/>
                            <Button Content="Attach+SendInput → target" Click="AttachTarget_Click"/>
                            <Button Content="SendInput (foreground)" Click="SendInputFg_Click"/>
                            <Button Content="Send /loc → target" Click="LocTarget_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="ForegroundLabel" Grid.Row="5" Margin="0,8,0,4"
                                   Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11"
                                   Text="foreground: —"/>

                        <TextBox x:Name="ProbeLog" Grid.Row="6" Height="120" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Warn}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== GRIND ===== -->
                    <Grid x:Name="PanelGrind" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border x:Name="GrindBanner" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                                    Background="#20303F" BorderBrush="#2A4A57" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GrindBannerDot" Width="12" Height="12" Fill="#5D6878" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GrindBannerText" Text="STOPPED — press Start grind" FontWeight="Bold" FontSize="14" Foreground="#C6D2DE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Text="Press Start grind and your avatar HUNTS: it roams, targets the nearest NPC, considers it, and runs your rotation until it drops — then rests and hunts again. EQL must be the active window (input only fires while EQL is focused; F12 stops anytime). Keys accept 0-9, A-Z, F1-F12, Tab, and mouse1–mouse5 — so target=Tab and con=mouse5 both work. Movement uses forward + strafe-left/right + back with right-mouse look; set your keys below. /loc: bind a key to a macro whose LAST line is /loc so the bot can keep your position live. Tip: make a NEW chat tab, right-click it → Filters → Other → Other (Misc) so /loc doesn't spam your main chat."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button Content="Target EverQuest" Click="TargetEq_Click"/>
                            <TextBlock x:Name="GrindTargetLabel" Text="target: —" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontFamily="Consolas"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"
                                   Text="Combat rotation — one &quot;key,delayMs&quot; per line (keys: 0-9, A-Z, F1-F12, Tab, mouse1-5). If it's one macro key, just one line:"/>
                        <TextBox x:Name="GrindRotation" Grid.Row="3" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="# key,delayMs  (your in-game macro is on 4)&#10;4,1400"/>

                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button Content="Start grind" Click="StartGrind_Click" Margin="0,0,8,8"/>
                            <Button Content="Stop (F12)" Click="StopGrind_Click" Margin="0,0,8,8"/>
                            <Button Content="Save settings" Click="SaveGrind_Click" Margin="0,0,16,8"/>
                            <CheckBox x:Name="HuntBox" Content="Hunt mode (roam &amp; find mobs)" IsChecked="True"
                                      Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <CheckBox x:Name="StopOnDeathBox" Content="stop on death" IsChecked="True"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                            <TextBlock Text="fwd" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntForwardKeyBox" Text="W" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBlock Text="back" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntBackKeyBox" Text="S" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBlock Text="strafe L" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntLeftKeyBox" Text="A" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Strafe left (with right-mouse held, this turns/strafes left)."/>
                            <TextBlock Text="strafe R" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntRightKeyBox" Text="D" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Strafe right (with right-mouse held, this turns/strafes right)."/>
                            <TextBlock Text="target" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntTargetKeyBox" Text="Tab" Width="54" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Bind 'target nearest NPC' to this in-game. Tab by default; can be a mouse button."/>
                            <TextBlock Text="con" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntConsiderKeyBox" Text="C" Width="64" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Consider the target. Type mouse5 to use your side mouse button."/>
                            <TextBlock Text="/loc" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntLocKeyBox" Text="" Width="54" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Optional: a key bound to a /loc macro. The bot taps it to keep position live."/>
                            <TextBlock Text="rest s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="HuntRestBox" Text="8" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <!-- Targeting suite: stance, hostile-only, tether, directive list (0.9.14) -->
                        <Border Grid.Row="5" Background="#121A28" BorderBrush="#26405A" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,2,0,6" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="TARGETING" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <TextBlock Text="Stance:" VerticalAlignment="Center" Margin="0,0,8,6"
                                               ToolTip="Behaves like a pet: how eager is the bot to start fights?"/>
                                    <RadioButton x:Name="StanceAggro" GroupName="stance" Content="Aggressive" IsChecked="True" Margin="0,0,12,6"
                                                 Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                 ToolTip="Attacks anything it finds while roaming (today's behavior)."/>
                                    <RadioButton x:Name="StanceDef" GroupName="stance" Content="Defensive" Margin="0,0,12,6"
                                                 Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                 ToolTip="Holds position and only fights back when something attacks first."/>
                                    <RadioButton x:Name="StanceDir" GroupName="stance" Content="Directive" Margin="0,0,12,6"
                                                 Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                                 ToolTip="Only engages mobs on the target list — feed it from the Game Data page."/>
                                    <CheckBox x:Name="HostileOnlyBox" Content="only scowls / threatening" Margin="0,0,12,6"
                                              Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                                              ToolTip="Skip anything whose /con attitude isn't scowls or glares threateningly — no faction accidents."/>
                                    <CheckBox x:Name="BardBox" Content="bard melody mode" Margin="0,0,12,6"
                                              Foreground="{StaticResource Text}" VerticalAlignment="Center"
                                              ToolTip="For bards running /melody: the FIRST rotation line is your melody hotkey. It fires once and keeps singing — the bot only recasts when the log says the melody stopped (stun, fizzled note, song end). No more interrupting your own songs."/>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="TetherBox" Content="tether to start point" VerticalAlignment="Center" Margin="0,0,10,4"
                                              Foreground="{StaticResource Text}"
                                              ToolTip="Anchors where the run starts (first /loc). The bot walks straight back inside whenever it crosses the radius, and the circle is drawn on the Maps page + overlay. Tight radii need a /loc key bound (or a repeating /loc macro) so its position stays fresh."/>
                                    <Slider x:Name="TetherSlider" Width="180" Minimum="10" Maximum="1500" Value="300"
                                            TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Center" Margin="0,0,8,4"
                                            ToolTip="10-unit steps below 50 for tight little camps; 50-unit steps from 50 up."
                                            ValueChanged="TetherSlider_Changed"/>
                                    <TextBlock x:Name="TetherLabel" Text="300 units" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDim}" Margin="0,0,16,4" MinWidth="70"/>
                                    <TextBlock Text="Directive targets:" VerticalAlignment="Center" Margin="0,0,6,4"
                                               Foreground="{StaticResource TextDim}"/>
                                    <TextBox x:Name="TargetMobsBox" Width="240" Height="44" AcceptsReturn="True" FontSize="11"
                                             FontFamily="Consolas" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" Margin="0,0,6,4"
                                             ToolTip="One mob name per line. Add from Game Data → pick a mob → 'Target with Grind'."/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="GrindStatsLabel" Grid.Row="6" Margin="0,4,0,4" FontFamily="Consolas"
                                   Foreground="{StaticResource Text}" Text="idle — keys 0 · kills 0 · xp 0 · loops 0"/>

                        <TextBox x:Name="GrindLog" Grid.Row="7" Height="96" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== COMBAT (live DPS meter + per-fight parse from the log) ===== -->
                    <Grid x:Name="PanelCombat" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Combat Meter" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,3,0,0"
                                       Text="Reads your damage from the log in real time — melee, spells, DoTs, and damage shields (grammar ported from EQ Legends Companion). The chart is dealt vs. taken DPS over the last 10 minutes; below it, each fight is parsed out with its DPS, duration, max hit, and crits. Needs the log folder set on Log Reader."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CombatLiveLabel" Text="DPS — dealt vs taken" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="CombatTotals" Grid.Column="1" Text="" FontSize="11" Foreground="#9FB6CC" FontFamily="Consolas"/>
                                </Grid>
                                <charts:TimeSeriesChart x:Name="CombatChart" Height="150" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Text="FIGHTS (most recent first — click one to chart it)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="2,0,0,4"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <ListView x:Name="FightsList" Grid.Column="0" Margin="0,0,10,0" Background="#0C0F13" Foreground="#EAF6FF" BorderBrush="#26405A"
                                      SelectionChanged="Fight_Selected" VirtualizingPanel.IsVirtualizing="True" FontSize="12">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time" Width="74" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="Target" Width="170" DisplayMemberBinding="{Binding Target}"/>
                                        <GridViewColumn Header="Dur" Width="46" DisplayMemberBinding="{Binding DurText}"/>
                                        <GridViewColumn Header="Dmg" Width="70" DisplayMemberBinding="{Binding DmgDealt}"/>
                                        <GridViewColumn Header="DPS" Width="60" DisplayMemberBinding="{Binding DpsText}"/>
                                        <GridViewColumn Header="Max" Width="54" DisplayMemberBinding="{Binding MaxHit}"/>
                                        <GridViewColumn Header="Crit" Width="42" DisplayMemberBinding="{Binding Crits}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="FightTitle" Text="Pick a fight" FontSize="13" FontWeight="Bold" Foreground="#EAF6FF"/>
                                    <TextBlock x:Name="FightSub" Text="its damage-per-second is charted here" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,6"/>
                                    <charts:TimeSeriesChart x:Name="FightChart" Height="150"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===== SESSIONS (recorded role runs: stats, rates, settings, heatmap replay) ===== -->
                    <Grid x:Name="PanelSessions" Margin="18" Visibility="Collapsed">
                        <Grid.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#121A28"/>
                                <Setter Property="Foreground" Value="#7FB2D9"/>
                                <Setter Property="BorderBrush" Value="#26405A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Session History" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,3,0,0"
                                       Text="Every role run records itself: duration, kills, XP ticks, AA points, the exact settings it ran with, and the travel trail. Click a column header to sort (click again to flip) — e.g. sort XP/h to find your best run, open it, and compare its settings against a slower one. XP has no amounts in the game's log, so XP is counted in ticks (gains); AA points are exact."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <ComboBox x:Name="SessRoleBox" Width="110" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      SelectionChanged="SessFilter_Changed">
                                <ComboBoxItem Content="All roles"/><ComboBoxItem Content="Grind"/><ComboBoxItem Content="Hunt"/><ComboBoxItem Content="Follower"/>
                            </ComboBox>
                            <TextBox x:Name="SessFilterBox" Width="220" VerticalAlignment="Center" Margin="0,0,8,0"
                                     TextChanged="SessFilter_Changed" ToolTip="Filter by zone, role, or any setting value (e.g. 'oasis', 'rest s: 8')."/>
                            <Button Content="Refresh" Click="SessRefresh_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SessCount" Text="" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                        </WrapPanel>

                        <ListView x:Name="SessList" Grid.Row="2" Background="#0C0F13" Foreground="#EAF6FF" BorderBrush="#26405A"
                                  SelectionChanged="SessList_Selected" GridViewColumnHeader.Click="SessSort_Click"
                                  VirtualizingPanel.IsVirtualizing="True" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="112" DisplayMemberBinding="{Binding DateText}"><GridViewColumn.Header><GridViewColumnHeader Content="Date" Tag="StartedAt"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="76" DisplayMemberBinding="{Binding Role}"><GridViewColumn.Header><GridViewColumnHeader Content="Role" Tag="Role"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="84" DisplayMemberBinding="{Binding DurationText}"><GridViewColumn.Header><GridViewColumnHeader Content="Duration" Tag="DurationSeconds"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding Actions}"><GridViewColumn.Header><GridViewColumnHeader Content="Actions" Tag="Actions"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="56" DisplayMemberBinding="{Binding Kills}"><GridViewColumn.Header><GridViewColumnHeader Content="Kills" Tag="Kills"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="56" DisplayMemberBinding="{Binding XpTicks}"><GridViewColumn.Header><GridViewColumnHeader Content="XP" Tag="XpTicks"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding XpRateText}"><GridViewColumn.Header><GridViewColumnHeader Content="XP/h" Tag="XpPerHour"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="50" DisplayMemberBinding="{Binding AaPoints}"><GridViewColumn.Header><GridViewColumnHeader Content="AA" Tag="AaPoints"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding AaRateText}"><GridViewColumn.Header><GridViewColumnHeader Content="AA/h" Tag="AaPerHour"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="66" DisplayMemberBinding="{Binding DpsText}"><GridViewColumn.Header><GridViewColumnHeader Content="DPS" Tag="Dps"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding AssistsText}"><GridViewColumn.Header><GridViewColumnHeader Content="Assists" Tag="Assists"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="82" DisplayMemberBinding="{Binding CombatShareText}"><GridViewColumn.Header><GridViewColumnHeader Content="In combat" Tag="CombatShare"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="50" DisplayMemberBinding="{Binding Deaths}"><GridViewColumn.Header><GridViewColumnHeader Content="Deaths" Tag="Deaths"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding PrimaryZone}"><GridViewColumn.Header><GridViewColumnHeader Content="Zone" Tag="PrimaryZone"/></GridViewColumn.Header></GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="3" Background="#0C0F13" BorderBrush="#26405A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0" MaxHeight="210">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SessDetailHint" Text="Select a session to see its settings, timeline chart, and heatmap." Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="SessDetail" Grid.Column="0"/>
                                        <charts:TimeSeriesChart x:Name="SessChart" Grid.Column="1" Height="150" VerticalAlignment="Top" Margin="8,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== GAME DATA (Companion catalogs: mobs, raid targets, PoSky, hunting guide) ===== -->
                    <Grid x:Name="PanelData" Margin="18" Visibility="Collapsed">
                        <Grid.Resources>
                            <Style x:Key="DataTab" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#9FB6CC"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" CornerRadius="16" Padding="14,6" Background="#121A28" BorderBrush="#26405A" BorderThickness="1">
                                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1B3A57"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                                    <Setter Property="Foreground" Value="#EAF6FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Mobs" IsChecked="True" Checked="DataTab_Checked" Content="Mobs"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Raid" Checked="DataTab_Checked" Content="Raid Targets"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Sky" Checked="DataTab_Checked" Content="Plane of Sky"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Guide" Checked="DataTab_Checked" Content="Hunting Guide"/>
                        </StackPanel>
                        <TextBlock x:Name="DataStatus" Grid.Row="1" FontSize="11" Foreground="{StaticResource TextDim}" Margin="2,0,0,8" Text="opening…"/>

                        <Grid Grid.Row="2">
                            <!-- MOBS -->
                            <Grid x:Name="DataViewMobs">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="DataSearchBox" Width="320" VerticalAlignment="Center" Margin="0,0,10,0"
                                             TextChanged="DataSearch_Changed"
                                             ToolTip="Search 7,872 mobs by name, zone, or drop — e.g. 'guk ghoul', 'flowing black', 'oasis'."/>
                                    <TextBlock x:Name="MobsCount" Text="" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
                                    <ListBox x:Name="MobsList" Grid.Column="0" Margin="0,0,10,0" Background="#0C0F13" BorderBrush="#26405A"
                                             SelectionChanged="MobsList_Selected" HorizontalContentAlignment="Stretch"
                                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <TextBlock Text="{Binding Name}" Foreground="#EAF6FF" FontSize="13"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LevelText}" Foreground="#7FB2D9" FontSize="11" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding ZonesText}" Foreground="#5D6878" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Column="1" Background="#0C0F13" BorderBrush="#26405A" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="MobDetail">
                                                <TextBlock Text="Pick a mob to see its levels, zones, and drops." Foreground="{StaticResource TextDim}" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- RAID -->
                            <ScrollViewer x:Name="DataViewRaid" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RaidHost" MaxWidth="640" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                            <!-- PLANE OF SKY -->
                            <Grid x:Name="DataViewSky" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Class" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="SkyClassBox" Width="160" SelectionChanged="SkyClass_Changed"/>
                                </WrapPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SkyHost" MaxWidth="720" HorizontalAlignment="Left"/>
                                </ScrollViewer>
                            </Grid>
                            <!-- HUNTING GUIDE -->
                            <Grid x:Name="DataViewGuide" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Your level" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="GuideLevelBox" Width="52" VerticalAlignment="Center" TextChanged="GuideLevel_Changed" Text="50"/>
                                    <TextBlock Text="zones ranked by how many catalog mobs sit within −3…+2 of you (computed, not hand-curated)" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11" Margin="10,0,0,0"/>
                                </WrapPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="GuideHost" MaxWidth="720" HorizontalAlignment="Left"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ===== MAPS (Companion-style zone maps: default + Brewall, heat overlay) ===== -->
                    <Grid x:Name="PanelMaps" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Zone" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsZoneBox" Width="230" IsEditable="True" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsZone_Selected" KeyDown="MapsZone_KeyDown"
                                      ToolTip="Pick a zone, or type its name (long names work: 'Nagafen's Lair' finds soldungb)."/>
                            <CheckBox x:Name="MapsFollowBox" Content="follow my zone" IsChecked="True" VerticalAlignment="Center"
                                      Foreground="{StaticResource TextDim}" Margin="0,0,14,6"
                                      ToolTip="Switch the map automatically when the log says you entered a new zone."/>
                            <TextBlock Text="geometry" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsGeoPackBox" Width="110" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsPack_Changed"
                                      ToolTip="Which pack draws the walls. Auto = the game's own maps (EQL-authoritative)."/>
                            <TextBlock Text="labels" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsLabelPackBox" Width="110" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsPack_Changed"
                                      ToolTip="Which pack supplies the labeled points. Auto = Brewall when installed (100× the labels)."/>
                            <TextBlock Text="EQ folder" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <TextBox x:Name="MapsEqRootBox" Width="150" VerticalAlignment="Center" Margin="0,0,4,6"
                                     ToolTip="Your EverQuest install folder (the one containing 'maps')."/>
                            <Button Content="Rescan" Click="MapsRescan_Click" Margin="0,0,0,6"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <CheckBox x:Name="MapsLabelsBox" Content="labels" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <CheckBox x:Name="MapsLegendBox" Content="legend" IsChecked="False" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,4"
                                      ToolTip="The pack's colour key + credits — drawn off-map by design, so it appears beside the zone."/>
                            <CheckBox x:Name="MapsExtraBox" Content="extra" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,4"
                                      ToolTip="The pack's third layer (_3 files), where one exists."/>
                            <CheckBox x:Name="MapsHeatBox" Content="heat" IsChecked="False" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,4"
                                      ToolTip="This session's /loc heatmap, drawn over the real zone walls."/>
                            <CheckBox x:Name="MapsTrailBox" Content="trail" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,4"
                                      ToolTip="Your recent path, from live /loc."/>
                            <TextBlock Text="floor" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                            <Button x:Name="MapsFloorDown" Content="▼" Padding="8,3" Click="MapsFloorDown_Click" Margin="0,0,2,4"
                                    ToolTip="Step one floor down."/>
                            <Border Background="#13243B" CornerRadius="5" Padding="9,4" Margin="0,0,2,4" VerticalAlignment="Center">
                                <TextBlock x:Name="MapsFloorChip" Text="All levels" Foreground="#9FB6CC" FontSize="11.5"/>
                            </Border>
                            <Button x:Name="MapsFloorUp" Content="▲" Padding="8,3" Click="MapsFloorUp_Click" Margin="0,0,14,4"
                                    ToolTip="Step one floor up."/>
                            <Button Content="−" Padding="10,3" Click="MapsZoomOut_Click" Margin="0,0,2,4"/>
                            <Button Content="+" Padding="10,3" Click="MapsZoomIn_Click" Margin="0,0,2,4"/>
                            <Button Content="Fit" Click="MapsFit_Click" Margin="0,0,14,4"/>
                            <Button x:Name="MapsOverlayBtn" Content="Overlay in-game" Click="MapsOverlay_Click" Margin="0,0,2,4"
                                    ToolTip="Float THIS map (with heat/trail as toggled) over the game — transparent, always on top. The overlay's 'ghost' button makes it click-through."/>
                            <Button Content="Export PNG" Click="MapsExport_Click" Margin="0,0,0,4"
                                    ToolTip="Save the current map view (including the heat overlay) as a PNG to share."/>
                        </WrapPanel>

                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="#26405A" BorderThickness="1" ClipToBounds="True" Background="#0B121E">
                            <map:MapViewElement x:Name="MapsView"/>
                        </Border>

                        <TextBlock x:Name="MapsStatus" Grid.Row="3" Margin="2,6,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Text="Set your EQ folder and pick a zone."/>
                    </Grid>

                    <!-- ===== FOLLOWER (follow + assist a leader) ===== -->
                    <Grid x:Name="PanelFollower" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border x:Name="FollowerBanner" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                                    Background="#20303F" BorderBrush="#2A4A57" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FollowerBannerDot" Width="12" Height="12" Fill="#5D6878" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FollowerBannerText" Text="STOPPED — press Start follower" FontWeight="Bold" FontSize="14" Foreground="#C6D2DE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Text="Group play: run THIS instance where your second character plays, enter the leader's exact name, and press Start. The follower types /target + /follow into chat itself (no in-game socials needed), re-follows on a timer so a lost follow self-heals, and — when the leader's swings or casts show up in the log — waits a human-ish beat, /assists, turns attack on, and runs your rotation until the mob drops or the fight goes quiet. Then attack off, a short rest, and back on the leash. EQL must be the focused window on this PC (tab away = instant pause) and F12 stops it. If the leader name has a space or title, use just the first name."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button Content="Target EverQuest" Click="FollowerTargetEq_Click"/>
                            <TextBlock x:Name="FollowerTargetLabel" Text="target: —" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontFamily="Consolas"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"
                                   Text="Assist rotation — one &quot;key,delayMs&quot; per line (keys: 0-9, A-Z, F1-F12, Tab, mouse1-5). Leave empty for auto-attack only:"/>
                        <TextBox x:Name="FollowerRotation" Grid.Row="3" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="# key,delayMs  (e.g. your combat macro on 4)&#10;4,1400"/>

                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button Content="Start follower" Click="StartFollower_Click" Margin="0,0,8,8"/>
                            <Button Content="Stop (F12)" Click="StopFollower_Click" Margin="0,0,8,8"/>
                            <Button Content="Save settings" Click="SaveFollower_Click" Margin="0,0,16,8"/>
                            <CheckBox x:Name="FollowerAutoAssistBox" Content="auto-assist when the leader fights" IsChecked="True"
                                      Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="leader" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerLeaderBox" Text="" Width="110" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="The character to follow — exact first name, e.g. Bryari."/>
                            <TextBlock Text="re-follow s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerRefollowBox" Text="40" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Re-issue /target + /follow this often while idle, so a lost follow self-heals."/>
                            <TextBlock Text="assist delay ms" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerAssistDelayBox" Text="900" Width="52" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Human-ish pause between the leader engaging and this character joining in."/>
                            <TextBlock Text="max fight s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerMaxFightBox" Text="30" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBlock Text="rest s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerRestBox" Text="4" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock x:Name="FollowerStatsLabel" Grid.Row="5" Margin="0,4,0,4" FontFamily="Consolas"
                                   Foreground="{StaticResource Text}" Text="idle — assists 0 · kills 0 · re-follows 0"/>

                        <TextBox x:Name="FollowerLog" Grid.Row="6" Height="96" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== AUTO-LOGIN ===== -->
                    <Grid x:Name="PanelLogin" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Login Console" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0"
                                       Text="This is the log for the one-click Launch on Command Center. It reads each launch screen with Windows OCR and clicks it: the green PLAY on LaunchPad, your server + PLAY on server-select, then 'Enter World' at character select. Every string OCR sees is printed here, so if a click is missed you can tell me exactly what it read. Set the launcher path once and Launch can start the game for you too."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <TextBox x:Name="LoginServerBox" Text="Rivervale" Width="150" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Launcher:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <TextBox x:Name="LauncherPathBox" Text="" Width="240" VerticalAlignment="Center" Margin="0,0,6,8"
                                     ToolTip="Path to the EQL launcher exe (optional). If set, Launch starts it before auto-login."/>
                            <Button Content="Browse…" Click="PickLauncher_Click" Margin="0,0,12,8"/>
                            <Button Content="Start auto-login" Click="StartLogin_Click" Margin="0,0,8,8"/>
                            <Button Content="Stop" Click="StopLogin_Click" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <TextBox x:Name="LoginLog" Grid.Row="2" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== MOUSE ===== -->
                    <Grid x:Name="PanelMouse" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"
                                   Text="Fluid, varied cursor motion for the foreground automation: cosine ease-in-out for acceleration, a sine arc so the path curves, plus run-to-run randomness in speed, curve, and launch angle (timing uses your global variance %). The demo moves your REAL cursor around the screen so you can watch it — click Stop or press F12 to halt, and just move your mouse yourself to take back over."/>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Speed px/s:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseSpeedBox" Text="900" Width="64" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Arc:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseArcBox" Text="0.12" Width="54" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Angle jitter°:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseAngleBox" Text="6" Width="48" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <Button Content="Apply &amp; save" Click="ApplyMouse_Click"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button Content="Start fluid demo" Click="StartMouseDemo_Click"/>
                            <Button Content="Stop (F12)" Click="StopMouseDemo_Click"/>
                        </WrapPanel>

                        <TextBox x:Name="MouseLog" Grid.Row="3" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== LICENSING ===== -->
                    <Grid x:Name="PanelLicensing" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"
                                   Text="This install checks in to the central Client Hub: it reports who's running, on what tier, and what they're doing (actions, kills, xp, session time) to the shared dashboard. The hub answers with your tier and the roles it unlocks. Nothing here changes the game — it's the licensing + usage-reporting layer. Check-ins send only counts and your chosen name."/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Check in as" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LicUserBox" Margin="0,0,10,6"
                                       ToolTip="Your character or account name — this is what shows on the dashboard."/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Machine" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LicMachineLabel" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontFamily="Consolas" Margin="0,0,0,6" Text="—"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hub URL" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicUrlBox" Margin="0,0,0,6"
                                       FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicKeyBox" Margin="0,0,0,6"
                                       FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Character" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                <ComboBox x:Name="LicClassCombo" Width="150" VerticalAlignment="Center" Margin="0,0,8,4"
                                          ToolTip="Your character's class — drives the profile page stats and color."/>
                                <TextBlock Text="Lv" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                <TextBox x:Name="LicLevelBox" Text="1" Width="46" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                <ComboBox x:Name="LicRaceCombo" Width="130" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                <TextBlock Text="Server" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                <TextBox x:Name="LicServerBox" Text="Rivervale" Width="120" VerticalAlignment="Center" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,4,0,10">
                            <Button Content="Check in now" Click="CheckInNow_Click"/>
                            <Button Content="Save" Click="SaveLicensing_Click"/>
                            <Button Content="Open dashboard" Click="OpenDashboard_Click"/>
                            <CheckBox x:Name="LicAutoBox" Content="auto check-in every" Foreground="{StaticResource TextDim}"
                                      VerticalAlignment="Center" Margin="8,0,6,8" Click="LicAuto_Click"/>
                            <TextBox x:Name="LicIntervalBox" Text="120" Width="52" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBlock Text="s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentDim}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="LicTierBadge" CornerRadius="20" Padding="16,8"
                                        Background="#20303F" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="LicTierText" Text="not checked in" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource Text}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LicStatusText" Text="Set a name and click “Check in now”."
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LicRolesText" Text="roles: —" Foreground="{StaticResource TextDim}"
                                               FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="LicLastText" Text="last check-in: never" Foreground="{StaticResource TextDim}"
                                               FontSize="12" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="LicSessionText" Text="reporting: role Idle · actions 0 · kills 0 · xp 0"
                                               Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Character Sheet OCR: read the in-game Inventory window, no manual entry -->
                        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentDim}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="CHARACTER SHEET — READ FROM THE GAME" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,4,0,8"
                                           Text="Open your Inventory in-game (Equipment tab), leave it visible, and press Read. The app captures the game window, finds the sheet by its own labels, and reads vitals, attributes, resists, regens, weight, coin, and your name/level/class — the real numbers, straight off the screen. Then send them to your web profile."/>
                                <WrapPanel>
                                    <Button Content="Read inventory now" Click="OcrRead_Click" FontWeight="SemiBold" Margin="0,0,8,6"/>
                                    <CheckBox x:Name="OcrAutoBox" Content="auto-scan" Click="OcrAuto_Click" VerticalAlignment="Center" Margin="0,0,8,6"
                                              Foreground="{StaticResource Text}"
                                              ToolTip="Keeps watching the game every few seconds and reads the sheet automatically whenever the inventory is open — no button pressing. Sends to your profile at most every 10 minutes."/>
                                    <Button x:Name="OcrSendBtn" Content="Send to profile" Click="OcrSend_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                    <TextBlock x:Name="OcrStatus" Text="no read yet" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="OcrSummary" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" Text=""/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LAST 10 CONNECTIONS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="ConnRefresh_Click" Padding="10,2"/>
                                </Grid>
                                <ListView x:Name="ConnList" Height="152" Margin="0,8,0,0" Background="#0C0F13" Foreground="#EAF6FF"
                                          BorderBrush="#26405A" FontSize="12" VirtualizingPanel.IsVirtualizing="True">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="When" Width="108" DisplayMemberBinding="{Binding WhenText}"/>
                                            <GridViewColumn Header="Duration" Width="72" DisplayMemberBinding="{Binding DurText}"/>
                                            <GridViewColumn Header="Roles" Width="150" DisplayMemberBinding="{Binding RolesText}"/>
                                            <GridViewColumn Header="Actions" Width="68" DisplayMemberBinding="{Binding ActionsText}"/>
                                            <GridViewColumn Header="Kills" Width="54" DisplayMemberBinding="{Binding KillsText}"/>
                                            <GridViewColumn Header="XP" Width="74" DisplayMemberBinding="{Binding XpText}"/>
                                            <GridViewColumn Header="From" Width="104" DisplayMemberBinding="{Binding FromText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="ConnHint" Text="What this install did on the hub — sessions, roles used, and totals. Refreshes after each check-in."
                                           Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="LicLog" Grid.Row="6" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== SETTINGS ===== -->
                    <Grid x:Name="PanelSettings" Margin="22" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                                <TextBlock Text="Settings" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Global settings for the whole app. Per-module settings live on each panel and will migrate here over time." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,14"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="APPEARANCE" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tooltip opacity" VerticalAlignment="Center" ToolTip="How see-through the light-blue tooltips are. This is one of the new custom tooltips!"/>
                                            <Slider x:Name="TooltipOpacitySlider" Grid.Column="1" Minimum="0.5" Maximum="1.0" SmallChange="0.05" TickFrequency="0.05"
                                                    VerticalAlignment="Center" Margin="8,0" ValueChanged="TooltipOpacity_Changed"/>
                                            <TextBlock x:Name="TooltipOpacityVal" Grid.Column="2" Text="92%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextDim}"/>
                                        </Grid>
                                        <CheckBox x:Name="SettingsTopmostBox" Content="Keep the window on top of everything" Foreground="{StaticResource TextDim}"
                                                  Margin="0,10,0,0" Click="SettingsTopmost_Click"
                                                  ToolTip="On a two-monitor setup this floats the app over other apps and the game."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="AUTOMATION" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Timing variance %" VerticalAlignment="Center" ToolTip="Random +/- applied to every timed action so nothing looks metronomic."/>
                                            <TextBox x:Name="VarianceBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Pause on /tell (minutes)" VerticalAlignment="Center" ToolTip="Hold automation for this long when someone sends you a /tell."/>
                                            <TextBox x:Name="TellPauseBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="6,10,0,0">
                                    <Button Content="Save settings" Click="SaveSettings_Click"/>
                                    <Button Content="Check for updates" Click="CheckUpdates_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
