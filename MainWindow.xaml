<Window x:Class="EQAvatar.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:map="clr-namespace:EQAvatar.Spike.Map"
        xmlns:charts="clr-namespace:EQAvatar.Spike.Charts"
        xmlns:ui="clr-namespace:EQAvatar.Spike.Ui"
        Title="EQ Avatar" Height="720" Width="1060" MinHeight="560" MinWidth="900"
        WindowStyle="None" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- left-nav item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B9C6D4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="10,9">
                            <Grid>
                                <Rectangle x:Name="bar" Width="3" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}"
                                           HorizontalAlignment="Left" Margin="-7,3,0,3" Opacity="0"/>
                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#204FC3F7"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#EAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#8FA0B2"/>
        </Style>

        <Style x:Key="RailCap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5D6878"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,4,0,6"/>
        </Style>

        <!-- content card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="#262D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- window caption buttons -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FB0C2"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2A3242" BorderThickness="1" Background="{StaticResource Bg}">
        <DockPanel>

            <!-- ===================== TITLE BAR ===================== -->
            <Grid DockPanel.Dock="Top" Height="52" Background="#141926">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- the ghost, floating over the bar like on the site -->
                    <Grid Width="48" Height="50" Margin="0,0,8,0">
                        <Image x:Name="ArtGhostLogo" Width="64" Height="68" Stretch="Uniform" Margin="-8,-11,-8,-7"
                               IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Image.Effect>
                                <DropShadowEffect Color="#4FC3F7" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                            </Image.Effect>
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="GhostRot" Angle="-2"/>
                                    <TranslateTransform x:Name="GhostTrans" Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Image.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="GhostTrans" Storyboard.TargetProperty="Y"
                                                             From="-2.5" To="3.5" Duration="0:0:2.7">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GhostRot" Storyboard.TargetProperty="Angle"
                                                             From="-2.5" To="2.5" Duration="0:0:3.6">
                                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                    <TextBlock Text="EQ · AVATAR" FontWeight="Bold" FontSize="13" Foreground="#DBE6F2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- transient "settings saved" toast (fades out) -->
                <Border x:Name="SavedToast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#12261B" BorderBrush="#2C8C55" BorderThickness="1" CornerRadius="20" Padding="14,5"
                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#7CE38B" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SavedToastText" Text="Settings saved" Foreground="#B6F2C9" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- character profile chip -->
                <Border Grid.Column="2" x:Name="Chip" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                        Background="#0E1420" BorderBrush="#2F3849" BorderThickness="1" CornerRadius="30" Padding="6,4,12,4"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" MouseLeftButtonUp="Chip_Click"
                        ToolTip="Open your Profile">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E879F9" Offset="0"/>
                                    <GradientStop Color="#4FC3F7" Offset="0.5"/>
                                    <GradientStop Color="#7CE38B" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#0D141D">
                                <TextBlock x:Name="ChipAvatar" Text="?" FontWeight="Bold" Foreground="#EAF3FF" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChipDot" Width="8" Height="8" Fill="#5D6878" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ChipName" Text="Not signed in" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="ChipSub" Text="Licensing → set your name" Foreground="{StaticResource TextDim}" FontSize="11"/>
                        </StackPanel>
                        <Border x:Name="ChipTierBadge" CornerRadius="999" Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="Collapsed" BorderThickness="1.5" Cursor="Hand"
                                MouseLeftButtonUp="ChipTier_Click" ToolTip="Subscription &amp; licensing">
                            <TextBlock x:Name="ChipTierText" Text="" FontWeight="Bold" FontSize="10" Foreground="#0B0F16"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- window controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WinBtn}" Click="TitleMin_Click" Content="&#xE921;" ToolTip="Minimize"/>
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Click="TitleMax_Click" Content="&#xE922;" ToolTip="Maximize"/>
                    <Button Style="{StaticResource WinBtnClose}" Click="TitleClose_Click" Content="&#xE8BB;" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ===================== BODY ===================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT NAV RAIL -->
                <Border Grid.Column="0" Background="#10141D" BorderBrush="#20262F" BorderThickness="0,0,1,0">
                    <DockPanel Margin="10,12,10,10">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Content="Launch Method" Click="LaunchMethod_Click" HorizontalAlignment="Stretch" Margin="0,8,0,4"/>
                            <TextBlock x:Name="LaunchMethodLabel" Text="method: not set" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,0,0,0"/>
                            <!-- Ambient update chip (Companion-style): one calm line normally, a hairline
                                 bar while downloading, and a single gold "Restart to update" when a build is
                                 staged. It glows once on arrival, then rests. No popups, ever. -->
                            <Border x:Name="UpdaterChip" Margin="0,8,0,2" CornerRadius="6" Padding="10,6"
                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonUp="UpdaterChip_Click" ToolTip="Click to check for updates">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="UpdaterChipIcon" Text="⟳" FontSize="12" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" Foreground="#D9B25F" Visibility="Collapsed"/>
                                        <TextBlock x:Name="UpdaterChipText" Text="not checked yet" Foreground="{StaticResource TextDim}"
                                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdaterChipSub" Text="" Foreground="#E6C879" FontSize="10"
                                               FontFamily="Consolas" Margin="18,1,0,0" Visibility="Collapsed"/>
                                    <ProgressBar x:Name="UpdaterChipBar" Height="2" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                 Value="0" Background="#1AFFFFFF" Foreground="#D9B25F" BorderThickness="0"
                                                 Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="2,6,0,0" Foreground="#5D6878" FontSize="11">
                                <Run Text="EQ Avatar"/> <Run x:Name="VersionRun" Text="v0.9.1"/></TextBlock>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Style="{StaticResource RailCap}" Text="COMMAND"/>
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelHome" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE80F;"/><TextBlock Text="Command Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavGrind" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelGrind" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE72C;"/><TextBlock Text="Grind"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavFollower" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelFollower" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE716;"/><TextBlock Text="Follower"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSequencer" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelSequencer" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE762;"/><TextBlock Text="Action Sequencer"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavQuesting" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelQuesting" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8F1;"/><TextBlock Text="Questing"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMouse" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelMouse" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE962;"/><TextBlock Text="Mouse Motion"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="INSIGHT" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavCombat" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelCombat" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C1;"/><TextBlock Text="Combat"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavMaps" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelMaps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE909;"/><TextBlock Text="Maps"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavData" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelData" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE82D;"/><TextBlock Text="Game Data"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavKeymaps" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelKeymaps" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE765;"/><TextBlock Text="Key Mappings"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSessions" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelSessions" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE81C;"/><TextBlock Text="Sessions"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLog" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7C3;"/><TextBlock Text="Log Reader"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="DEBUG" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavInput" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelInput" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE765;"/><TextBlock Text="Input Probe"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLogin" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLogin" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE77B;"/><TextBlock Text="Login Console"/></StackPanel>
                            </RadioButton>

                            <TextBlock Style="{StaticResource RailCap}" Text="ACCOUNT" Margin="6,14,0,6"/>
                            <RadioButton x:Name="NavProfile" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelProfile" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE77B;"/><TextBlock Text="Profile"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavLicensing" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelLicensing" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE72E;"/><TextBlock Text="Licensing"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="PanelSettings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;"/><TextBlock Text="Settings"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CONTENT AREA (panels overlap; one visible at a time) -->
                <Grid Grid.Column="1">

                    <!-- ===== COMMAND CENTER (home) ===== -->
                    <Grid x:Name="PanelHome">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,20,22,22">

                                <!-- ===== LAUNCH HERO (mascot + one-click launch) ===== -->
                                <Border Margin="0,0,0,16" CornerRadius="14" BorderBrush="#26405A" BorderThickness="1" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#13243B" Offset="0"/>
                                            <GradientStop Color="#0E1A2A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="132" Height="150" Margin="8,0,0,0">
                                            <Ellipse Width="118" Height="118" Opacity="0.20" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                                <Ellipse.Fill>
                                                    <RadialGradientBrush><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#004FC3F7" Offset="1"/></RadialGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Image x:Name="MascotImg" Stretch="Uniform" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,18,18,18" VerticalAlignment="Center">
                                            <TextBlock Text="Ready when you are." FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
                                            <TextBlock x:Name="LaunchStatus" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,12"
                                                       Text="One click launches EverQuest, clicks the green Play, picks your server, and takes you to Enter World. Progress streams into the Login Console."/>
                                            <WrapPanel>
                                                <Button Content="▶  Launch Game" Click="LaunchGame_Click" FontWeight="Bold" Padding="18,9" Margin="0,0,10,6"/>
                                                <Button Content="Login Console →" Click="HomeGoLogin_Click" Margin="0,0,10,6"/>
                                                <Button Content="Set launcher…" Click="PickLauncher_Click" Margin="0,0,10,6"/>
                                                <CheckBox x:Name="TopmostBox" Content="Stay on top (except the game)" IsChecked="True" Click="TopmostBox_Click"
                                                          Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Command Center" FontSize="19" FontWeight="Bold"/>
                                        <TextBlock Text="Everything your character is doing right now, at a glance." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#10261B" BorderBrush="#275C3C" BorderThickness="1" CornerRadius="30" Padding="12,7" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="HomeStatusDot" Width="8" Height="8" Fill="{StaticResource Good}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="HomeStatusPill" Text="Idle" Foreground="#B6F2C9" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Rows="1" Columns="4">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="SESSION" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeSession" Text="0m" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="KILLS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeKills" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="XP TICKS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeXp" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel><TextBlock Text="ACTIONS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeActions" Text="0" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="DAMAGE — LAST 10 MIN" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                            <TextBlock x:Name="HomeDpsLabel" Grid.Column="1" Text="0 DPS" FontSize="11" Foreground="#7CE38B" FontWeight="SemiBold"/>
                                        </Grid>
                                        <charts:TimeSeriesChart x:Name="HomeDpsChart" Height="120" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="THIS SESSION" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Role" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeRole" Grid.Column="1" Text="Idle"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Target" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeTarget" Grid.Column="1" Text="no target set"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Panic stop" Foreground="{StaticResource TextDim}"/><TextBlock Grid.Column="1" Text="F12 (works in-game)"/></Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ACCOUNT" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Character" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeChar" Grid.Column="1" Text="—"/></Grid>
                                            <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tier" Foreground="{StaticResource TextDim}"/><TextBlock x:Name="HomeTier" Grid.Column="1" Text="not checked in"/></Grid>
                                            <Button Content="Open dashboard" Click="OpenDashboard_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="6,12,0,0">
                                    <Button Content="Go to Grind" Click="HomeGoGrind_Click"/>
                                    <Button Content="Maps &amp; heat" Click="HomeGoHeat_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== LOG READER ===== -->
                    <Grid x:Name="PanelLog" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Log folder" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogFolderBox" Grid.Column="1" Text="G:\EQ\Logs"/>
                            <Button Grid.Column="2" Content="Browse…" Click="BrowseLogFolder_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="eqclient.ini" VerticalAlignment="Center"/>
                            <TextBox x:Name="IniPathBox" Grid.Column="1" Text="G:\EQ\eqclient.ini"/>
                            <Button Grid.Column="2" Content="Browse…" Click="BrowseIni_Click"/>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button Content="Find newest log" Click="FindNewest_Click"/>
                            <Button Content="Ensure Log=1" Click="EnsureLog_Click"/>
                            <Button Content="Read whole file" Click="ReadAll_Click"/>
                            <Button Content="Live tail" Click="Tail_Click"/>
                            <Button Content="Stop" Click="StopTail_Click"/>
                            <Button Content="Clear" Click="ClearLog_Click"/>
                        </WrapPanel>

                        <ListBox x:Name="LogList" Grid.Row="3" Background="#0C0F13"
                                 BorderBrush="{StaticResource AccentDim}" FontFamily="Consolas" FontSize="12"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="◈ Location lines seen: " Foreground="{StaticResource TextDim}"/>
                            <TextBlock x:Name="LocCount" Text="0" Foreground="{StaticResource Good}" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusLog" Margin="20,0,0,0" Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== INPUT PROBE ===== -->
                    <Grid x:Name="PanelInput" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="ElevBorder" Grid.Row="0" Background="#33FFCB6B" BorderBrush="#FFCB6B"
                                BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock x:Name="ElevBanner" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Checking elevation…"/>
                                <Button Content="Relaunch as administrator" Click="RelaunchAdmin_Click"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"
                                   Text="These are diagnostics. EQL only accepts input while it is the FOCUSED window — so clicking a button here sends while this app has focus, which is exactly why nothing seemed to happen. Two ways around it: keep 'give me 3s to click into EQ' checked and each button counts down so you can click into the game first; OR with EQ focused, press Ctrl+Alt+F9 to re-fire the last action. For real automation, use the Grind panel — it only fires while EQ is focused and auto-pauses when you tab away, so it just works. Run as administrator if EQL is elevated."/>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                            <Button Content="Refresh window list" Click="RefreshWindows_Click"/>
                            <Button Content="Guess EverQuest" Click="GuessEq_Click"/>
                            <Button Content="List child windows →" Click="ListChildren_Click"/>
                            <TextBlock Text="Key:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                            <TextBox x:Name="KeyBox" Text="1" Width="42" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ExtendedBox" Content="extended key" Foreground="{StaticResource TextDim}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </WrapPanel>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock DockPanel.Dock="Top" Text="Top-level windows" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"/>
                                <ListBox x:Name="WinList" Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Child controls (of selected window)" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"/>
                                <ListBox x:Name="ChildList" Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                         FontFamily="Consolas" FontSize="11"/>
                            </DockPanel>
                        </Grid>

                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <CheckBox x:Name="ProbeCountdownBox" Content="give me 3s to click into EQ" IsChecked="True"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,8"/>
                            <Button Content="PostMessage → target" Click="PostTarget_Click"/>
                            <Button Content="SendMessage → target" Click="SendMsgTarget_Click"/>
                            <Button Content="Attach+SendInput → target" Click="AttachTarget_Click"/>
                            <Button Content="SendInput (foreground)" Click="SendInputFg_Click"/>
                            <Button Content="Send /loc → target" Click="LocTarget_Click"/>
                        </WrapPanel>

                        <TextBlock x:Name="ForegroundLabel" Grid.Row="5" Margin="0,8,0,4"
                                   Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11"
                                   Text="foreground: —"/>

                        <TextBox x:Name="ProbeLog" Grid.Row="6" Height="120" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Warn}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== GRIND ===== -->
                    <Grid x:Name="PanelGrind" Margin="18" Visibility="Collapsed">
                        <Grid.Resources>
                            <!-- selectable scene tile (modes + stances): accent ring when chosen -->
                            <Style x:Key="SceneTile" TargetType="RadioButton">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" BorderThickness="2" BorderBrush="#26303F" CornerRadius="9"
                                                    Background="#0B121E" Padding="3" ClipToBounds="True"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Grid>
                                                    <ContentPresenter/>
                                                    <Border x:Name="hl" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" CornerRadius="6"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                                    <Setter TargetName="bd" Property="Background" Value="#10233A"/>
                                                    <Setter TargetName="hl" Property="Opacity" Value="0.10"/>
                                                    <Setter TargetName="bd" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#4FC3F7" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="bd" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#3E7CA6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="TileCaption" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#EAF6FF"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,4,0,0"/>
                            </Style>
                            <Style x:Key="TileSub" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="10.5"/>
                                <Setter Property="Foreground" Value="#9FB6CC"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="SectionCard" TargetType="Border">
                                <Setter Property="Background" Value="#121A28"/>
                                <Setter Property="BorderBrush" Value="#26405A"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- header: status banner + target-game icon + info -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GrindBanner" CornerRadius="8" Padding="12,9"
                                    Background="#20303F" BorderBrush="#2A4A57" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="GrindBannerDot" Width="12" Height="12" Fill="#5D6878" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GrindBannerText" Text="STOPPED — press Start" FontWeight="Bold" FontSize="14" Foreground="#C6D2DE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="GrindTargetBtn" Content="◎" Width="36" Height="36" FontSize="17" Padding="0"
                                        Click="TargetEq_Click"
                                        ToolTip="Target EverQuest. Auto-detected when this page opens — click to re-detect if you restarted the game."/>
                                <TextBlock x:Name="GrindTargetLabel" Text="—" VerticalAlignment="Center" Margin="7,0,10,0"
                                           Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11"
                                           MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                                <Button Content="ⓘ" Width="32" Height="32" FontSize="15" Padding="0" Click="GrindInfo_Click"
                                        ToolTip="How the Grind role works — everything that used to be written on this page."/>
                            </StackPanel>
                        </Grid>

                        <!-- start / stop / save as mascot scenes -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="StartGrind_Click" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                    BorderBrush="#2C8C55" BorderThickness="1.6" Background="#0B121E"
                                    ToolTip="Start the selected hunting mode. EQL must be the focused window.">
                                <Grid ClipToBounds="True">
                                    <Image x:Name="ArtStart" Stretch="UniformToFill" Height="132"/>
                                    <Border VerticalAlignment="Bottom" Background="#C8060B10" Padding="8,4">
                                        <TextBlock Text="▶  START" FontWeight="Bold" FontSize="13.5" Foreground="#7CE38B" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Click="StopGrind_Click" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                                    BorderBrush="#7A6320" BorderThickness="1.6" Background="#0B121E"
                                    ToolTip="Stop everything. F12 does the same from anywhere, even with the game focused.">
                                <Grid ClipToBounds="True">
                                    <Image x:Name="ArtStop" Stretch="UniformToFill" Height="132"/>
                                    <Border VerticalAlignment="Bottom" Background="#C8060B10" Padding="8,4">
                                        <TextBlock Text="■  STOP  (F12)" FontWeight="Bold" FontSize="13.5" Foreground="#FFCB6B" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Click="SaveGrind_Click" Padding="0" Cursor="Hand"
                                    BorderBrush="#26405A" BorderThickness="1.6" Background="#0B121E"
                                    ToolTip="Pack it all away — saves every setting on this page.">
                                <Grid ClipToBounds="True">
                                    <Image x:Name="ArtSave" Stretch="UniformToFill" Height="132"/>
                                    <Border VerticalAlignment="Bottom" Background="#C8060B10" Padding="8,4">
                                        <TextBlock Text="🎒  SAVE SETTINGS" FontWeight="Bold" FontSize="12.5" Foreground="#9FD8FF" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <!-- HUNTING MODE -->
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="ArtModes" Stretch="Uniform"/>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#C8060B10" Padding="10,4" CornerRadius="0,8,0,0">
                                                <TextBlock Text="HUNTING MODE" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9"/>
                                            </Border>
                                        </Grid>
                                        <UniformGrid Columns="4" Margin="0,8,0,4">
                                            <RadioButton x:Name="ModeTileHunt" GroupName="modeTile" Style="{StaticResource SceneTile}" Checked="ModeTile_Checked" IsChecked="True"
                                                         ToolTip="Search &amp; destroy: roam the area, target, consider, fight, rest, repeat.">
                                                <StackPanel>
                                                    <Image x:Name="ArtModeHunt" Height="80" Stretch="UniformToFill"/>
                                                    <TextBlock Text="HUNT" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="roam &amp; destroy" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeTileCamp" GroupName="modeTile" Style="{StaticResource SceneTile}" Checked="ModeTile_Checked"
                                                         ToolTip="Hold this exact spot and kill the respawns — it barely moves, so hazards around the camp can't swallow it.">
                                                <StackPanel>
                                                    <Image x:Name="ArtModeCamp" Height="80" Stretch="UniformToFill"/>
                                                    <TextBlock Text="CAMP" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="hold this spot" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeTileZone" GroupName="modeTile" Style="{StaticResource SceneTile}" Checked="ModeTile_Checked"
                                                         ToolTip="Hunts only inside the circle / rectangle / polygon you draw on the Maps page.">
                                                <StackPanel>
                                                    <Image x:Name="ArtModeZone" Height="80" Stretch="UniformToFill"/>
                                                    <TextBlock Text="HUNTING ZONE" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="stay in the drawn area" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeTileWp" GroupName="modeTile" Style="{StaticResource SceneTile}" Checked="ModeTile_Checked" Margin="0"
                                                         ToolTip="Patrols the waypoint route you draw on the Maps page — closely, never exactly. Looks human.">
                                                <StackPanel>
                                                    <Image x:Name="ArtModeWp" Height="80" Stretch="UniformToFill"/>
                                                    <TextBlock Text="WAYPOINTS" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="patrol the route" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                        <WrapPanel>
                                            <ComboBox x:Name="GrindModeBox" Width="10" Visibility="Collapsed" SelectionChanged="GrindMode_Changed">
                                                <ComboBoxItem Content="Hunt" IsSelected="True"/>
                                                <ComboBoxItem Content="Camp"/>
                                                <ComboBoxItem Content="Hunting Zone"/>
                                                <ComboBoxItem Content="Waypoints"/>
                                                <ComboBoxItem Content="Rotation only"/>
                                            </ComboBox>
                                            <CheckBox x:Name="HuntBox" IsChecked="True" Visibility="Collapsed"/>
                                            <ComboBox x:Name="WaypointOrderBox" Width="150" VerticalAlignment="Center" Margin="0,0,8,4" Visibility="Collapsed"
                                                      ToolTip="Sequence walks 1→N then back again (ping-pong). Loop walks 1→N then straight back to 1 and round again — use this for a circuit. Random hops between waypoints like a player with no plan."
                                                      SelectionChanged="WaypointOrder_Changed">
                                                <ComboBoxItem Content="In sequence ⇄" IsSelected="True"/>
                                                <ComboBoxItem Content="Random order"/>
                                                <ComboBoxItem Content="Loop ↻"/>
                                            </ComboBox>
                                            <Button x:Name="GrindPlanBtn" Content="Draw on map →" Visibility="Collapsed" Margin="0,0,10,4"
                                                    Click="GrindPlan_Click" ToolTip="Opens the Maps page with the drawing tools for this mode."/>
                                            <CheckBox x:Name="RotOnlyBox" Content="rotation only (no movement)" Click="RotOnly_Click" VerticalAlignment="Center" Margin="0,0,10,4"
                                                      Foreground="{StaticResource TextDim}"
                                                      ToolTip="Ignore the mode tiles and just cycle the combat rotation in place — the original grind."/>
                                            <CheckBox x:Name="CastOnlyBox" Content="cast spell/song only" Click="CastOnly_Click" VerticalAlignment="Center" Margin="0,0,10,4"
                                                      Foreground="{StaticResource TextDim}"
                                                      ToolTip="Caster / bard mode: fights with spells and songs only. It never turns to face the mob and never steps closer mid-fight — all that time goes into the rotation instead. If EQ says the target is out of range or out of sight, it drops that target and hunts a reachable one."/>
                                            <CheckBox x:Name="StopOnDeathBox" Content="stop on death" IsChecked="True" VerticalAlignment="Center" Margin="0,0,4,4"
                                                      Foreground="{StaticResource TextDim}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- TARGETING -->
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="ArtTargeting" Stretch="Uniform"/>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#C8060B10" Padding="10,4" CornerRadius="0,8,0,0">
                                                <TextBlock Text="TARGETING — STANCE" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9"/>
                                            </Border>
                                        </Grid>
                                        <UniformGrid Columns="3" Margin="0,8,0,4">
                                            <RadioButton x:Name="StanceAggro" GroupName="stance" Style="{StaticResource SceneTile}" Checked="Stance_Checked" IsChecked="True"
                                                         ToolTip="Attacks anything it finds while working the selected mode.">
                                                <StackPanel>
                                                    <Image x:Name="ArtStanceA" Height="86" Stretch="UniformToFill"/>
                                                    <TextBlock Text="AGGRESSIVE" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="attack on sight" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="StanceDef" GroupName="stance" Style="{StaticResource SceneTile}" Checked="Stance_Checked"
                                                         ToolTip="Holds its ground and only fights back when something attacks first.">
                                                <StackPanel>
                                                    <Image x:Name="ArtStanceD" Height="86" Stretch="UniformToFill"/>
                                                    <TextBlock Text="DEFENSIVE" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="fight back only" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="StanceDir" GroupName="stance" Style="{StaticResource SceneTile}" Checked="Stance_Checked" Margin="0"
                                                         ToolTip="Only engages mobs on your directive list — pick them on the Game Data page.">
                                                <StackPanel>
                                                    <Image x:Name="ArtStanceDir" Height="86" Stretch="UniformToFill"/>
                                                    <TextBlock Text="DIRECTIVE" Style="{StaticResource TileCaption}"/>
                                                    <TextBlock Text="only the chosen list" Style="{StaticResource TileSub}"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                        <WrapPanel>
                                            <ComboBox x:Name="HostileSelBox" Width="235" VerticalAlignment="Center" Margin="0,2,10,2"
                                                      ToolTip="Faction filter for Aggressive / Defensive: engage anything, or only mobs whose /con reads scowls or glares threateningly.">
                                                <ComboBoxItem Content="engage anything the mode finds" IsSelected="True"/>
                                                <ComboBoxItem Content="only scowls / threatening cons"/>
                                            </ComboBox>
                                            <StackPanel x:Name="DirectiveRow" Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBlock Text="Directive targets:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDim}"/>
                                                <TextBox x:Name="TargetMobsBox" Width="230" Height="42" AcceptsReturn="True" FontSize="11"
                                                         FontFamily="Consolas" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" Margin="0,0,8,0"
                                                         ToolTip="One mob name per line."/>
                                                <Button Content="pick from Game Data →" Click="GrindData_Click" VerticalAlignment="Center"
                                                        ToolTip="Browse the bestiary and press '☠ Target with Grind' on any mob."/>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- TETHER -->
                                <Border Style="{StaticResource SectionCard}">
                                    <StackPanel>
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="ArtTether" Stretch="Uniform"/>
                                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#C8060B10" Padding="10,4" CornerRadius="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TETHER" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                                    <CheckBox x:Name="TetherBox" Content="leash her to the start point" VerticalAlignment="Center" Margin="14,0,0,0"
                                                              Foreground="{StaticResource Text}"
                                                              ToolTip="Anchors where the run starts (first /loc). She walks straight back inside whenever she crosses the radius; the circle shows on the Maps page + overlay. Tight radii want a /loc key bound so her position stays fresh."/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="58" Height="58" CornerRadius="29" ClipToBounds="True" BorderBrush="#4FC3F7" BorderThickness="1.6" VerticalAlignment="Center">
                                                <Image x:Name="ArtTetherFace" Stretch="UniformToFill"
                                                       ToolTip="How she feels about the leash length. Short = worried. Long = won the lottery."/>
                                            </Border>
                                            <ui:TetherRope x:Name="TetherRope" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Height="52"/>
                                        </Grid>
                                        <TextBlock x:Name="TetherLabel" Text="300 units" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- SETTINGS -->
                                <Expander IsExpanded="False" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="480" Height="176" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image x:Name="ArtSettings" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="GRIND SETTINGS" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                            <TextBlock Text="keybinds · levitate" FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="fwd" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntForwardKeyBox" Text="W" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBlock Text="back" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntBackKeyBox" Text="S" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBlock Text="strafe L" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntLeftKeyBox" Text="A" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBlock Text="strafe R" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntRightKeyBox" Text="D" Width="44" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                                <TextBlock Text="target" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntTargetKeyBox" Text="Tab" Width="54" VerticalAlignment="Center" Margin="0,0,8,8"
                                                         ToolTip="Bind 'target nearest NPC' to this in-game. Can be a mouse button."/>
                                                <TextBlock Text="con" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntConsiderKeyBox" Text="C" Width="64" VerticalAlignment="Center" Margin="0,0,8,8"
                                                         ToolTip="Consider the target. mouse5 works."/>
                                                <TextBlock Text="/loc" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntLocKeyBox" Text="" Width="54" VerticalAlignment="Center" Margin="0,0,8,8"
                                                         ToolTip="A key bound to a /loc macro — the bot taps it to keep position live. Strongly recommended for tether / camp / waypoints."/>
                                                <TextBlock Text="rest s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                                                <TextBox x:Name="HuntRestBox" Text="8" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <WrapPanel>
                                                <CheckBox x:Name="LevBox" Content="keep Levitate up" VerticalAlignment="Center" Margin="0,0,6,4" Foreground="{StaticResource Text}"
                                                          ToolTip="Casts your Levitate hotkey at the start and re-casts when the log says it wore off. While levitating she rides her view just above the horizon and floats over pits and water."/>
                                                <TextBlock Text="cast key" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{StaticResource TextDim}"/>
                                                <TextBox x:Name="LevKeyBox" Width="46" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                                <TextBlock Text="buff name" VerticalAlignment="Center" Margin="0,0,4,4" Foreground="{StaticResource TextDim}"/>
                                                <TextBox x:Name="LevNameBox" Width="90" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- COMPASS -->
                                <Expander IsExpanded="False" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="480" Height="176" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image x:Name="ArtCompass" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="COMPASS" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                            <Border x:Name="CompassVerdict" Background="#2A2410" BorderBrush="#7A6320" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="CompassVerdictText" Text="not set" FontSize="10.5" Foreground="#FFE1A6"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,6,0,0">
                                        <WrapPanel>
                                            <Button Content="Pick region" Click="CompassPick_Click" Margin="0,0,6,4" Padding="10,3"
                                                    ToolTip="Captures the game and lets you drag a box around the compass strip (make it fully opaque in-game). One-time; survives window moves."/>
                                            <Button x:Name="CompassSpinBtn" Content="Spin-calibrate" Click="CompassSpin_Click" Margin="0,0,8,4" Padding="10,3"
                                                    ToolTip="Stand somewhere safe with EQ on screen; she turns up to two circles (~5–25s) to fingerprint the compass and measure exactly how many mouse-pixels make 360°."/>
                                            <TextBlock x:Name="CompassStatus" Text="not set" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                        </WrapPanel>
                                    </Border>
                                </Expander>

                                <!-- VITALS (rest gating) -->
                                <Expander IsExpanded="False" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="480" Height="176" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image x:Name="ArtVision" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="WHAT SHE CAN SEE — RESTING &amp; TARGETING" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                            <Border x:Name="VitalsVerdict" Background="#2A2410" BorderBrush="#7A6320" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="VitalsVerdictText" Text="not set" FontSize="10.5" Foreground="#FFE1A6"/>
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,7"
                                                       Text="EQ's log never reports health or mana, so she reads your HUD bars directly. Stand at FULL health and mana, then pick each bar once — she learns what a full bar looks like and measures the fill from then on. With this set she stops resting after fights she walked away from clean, and when she does rest she gets up the moment she's recovered instead of sitting out a fixed timer."/>
                                            <WrapPanel>
                                                <Button Content="Pick HP bar" Click="VitalsPickHp_Click" Margin="0,0,6,4" Padding="10,3"
                                                        ToolTip="Captures the game and lets you drag a box over your health bar. Be at FULL health when you do it."/>
                                                <Button Content="Pick mana bar" Click="VitalsPickMana_Click" Margin="0,0,6,4" Padding="10,3"
                                                        ToolTip="Same for mana. Skip this one for a melee character and set the mana threshold to 0."/>
                                                <Button Content="Test read" Click="VitalsTest_Click" Margin="0,0,10,4" Padding="10,3"
                                                        ToolTip="Reads both bars right now and prints the percentages, so you can check them against what the game shows."/>
                                                <TextBlock x:Name="VitalsStatus" Text="not set" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <CheckBox x:Name="RestGateBox" Content="only rest when below" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"
                                                          Checked="VitalsGate_Changed" Unchecked="VitalsGate_Changed"
                                                          Foreground="{StaticResource Text}"
                                                          ToolTip="Off = the old behaviour: a fixed pause after every fight regardless of how it went."/>
                                                <TextBox x:Name="RestHpBox" Width="44" Text="80" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                                <TextBlock Text="% health   or" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,8,4"/>
                                                <TextBox x:Name="RestManaBox" Width="44" Text="80" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                                <TextBlock Text="% mana   ·  give up after" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,8,4"/>
                                                <TextBox x:Name="RestMaxBox" Width="48" Text="180" VerticalAlignment="Center" Margin="0,0,4,4"
                                                         ToolTip="Safety cap: however low the bars read, she never rests longer than this before carrying on."/>
                                                <TextBlock Text="s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                            </WrapPanel>

                                            <Border Background="#0E1723" BorderBrush="#26405A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,7"
                                                               Text="Target window — so she stops considering thin air. EQ's log never mentions targeting, so pressing Tab at nothing looks exactly like pressing it at a mob, and she used to /consider on every pass to find out. Get a mob targeted, then pick your target window: she'll compare against it and only consider when something really is selected."/>
                                                    <WrapPanel>
                                                        <Button Content="Pick target window" Click="TargetPick_Click" Margin="0,0,6,4" Padding="10,3"
                                                                ToolTip="Target any mob first, then drag a box over your target window — include its frame and name, not just the health bar."/>
                                                        <Button Content="Test target read" Click="TargetTest_Click" Margin="0,0,10,4" Padding="10,3"
                                                                ToolTip="Prints how much of the window matches right now. Try it once with a target and once without — you want a clear gap either side of the threshold."/>
                                                        <CheckBox x:Name="TargetGateBox" Content="only consider when targeted" IsChecked="True" VerticalAlignment="Center" Margin="0,0,8,4"
                                                                  Checked="TargetGate_Changed" Unchecked="TargetGate_Changed" Foreground="{StaticResource Text}"/>
                                                        <TextBlock Text="match ≥" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                                        <TextBox x:Name="TargetMatchBox" Width="44" Text="60" VerticalAlignment="Center" Margin="0,0,4,4"
                                                                 ToolTip="How much of the window has to match. Test it with and without a target: put this number in the gap between the two readings. Lower it if she misses real targets, raise it if she thinks empty ground is a target."/>
                                                        <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,10,4"/>
                                                        <TextBlock x:Name="TargetStatus" Text="not set" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- COMBAT ROTATION -->
                                <Expander x:Name="RotationExpander" IsExpanded="False" Foreground="{StaticResource Text}" Margin="0,0,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="480" Height="176" CornerRadius="7" ClipToBounds="True" Margin="0,0,10,0">
                                                <Image x:Name="ArtRotation" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="COMBAT ROTATION" FontWeight="Bold" FontSize="12" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="RotationSummary" Text="empty — click to set up" FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Style="{StaticResource SectionCard}" Margin="0,6,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="BardBox" Content="bard melody mode" Margin="0,0,0,7" Foreground="{StaticResource Text}"
                                                      ToolTip="For bards running /melody: the FIRST rotation line is your melody hotkey. It fires once and keeps singing — the bot recasts ONLY when the log says the melody stopped (stun, missed note, song end)."/>
                                            <Grid>
                                                <TextBox x:Name="GrindRotation" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" MinHeight="88"
                                                         Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                                         VerticalScrollBarVisibility="Auto" TextChanged="RotationText_Changed" Text=""
                                                         ToolTip="One key per line, with an optional delay: '4,1400' presses 4 then waits 1.4s. Leave the delay off ('4' alone) and 3.2 seconds is assumed — the 3s global cooldown plus 200ms for latency. Keys: 0-9, A-Z, F1-F24, Tab, Home/End/PgUp/PgDn, mouse1-5. An in-game macro key counts as one line. Lines starting with # are comments."/>
                                                <TextBlock x:Name="RotationHint" IsHitTestVisible="False" Margin="8,6,8,6" Foreground="#5D6878" FontFamily="Consolas" FontSize="11.5"
                                                           Text="one key per line — e.g.&#10;4&#10;delay optional: '4,1400' waits 1.4s; none = 3.2s (GCD + latency)"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <Border Background="#16202E" BorderBrush="#2A4A57" BorderThickness="1" CornerRadius="999"
                                                        Width="22" Height="22" Cursor="Hand" MouseLeftButtonUp="GrindInfo_Click"
                                                        ToolTip="Open the full guide — every key name, delays, bard melody mode, macro tips.">
                                                    <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="13"
                                                               Foreground="#7FB2D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                </Border>
                                                <TextBlock Text="hover a field for help — or press the info button for the full guide"
                                                           FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <TextBlock x:Name="GrindStatsLabel" Margin="0,0,0,4" FontFamily="Consolas"
                                           Foreground="{StaticResource Text}" Text="idle — keys 0 · kills 0 · xp 0 · loops 0"/>

                                <TextBox x:Name="GrindLog" Height="96" IsReadOnly="True"
                                         Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>

                                <Expander Margin="0,8,0,0" Foreground="{StaticResource Text}" IsExpanded="False"
                                          Expanded="GrindSess_Expanded">
                                    <Expander.Header>
                                        <TextBlock Text="PREVIOUS GRIND SESSIONS" FontSize="11.5" FontWeight="Bold" Foreground="#7FB2D9"/>
                                    </Expander.Header>
                                    <StackPanel Margin="0,6,0,0">
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="filter" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,5,0"/>
                                            <TextBox x:Name="GrindSessFilter" Width="180" TextChanged="GrindSessFilter_Changed"
                                                     ToolTip="Type to filter by mode or zone. Click any column header to sort."/>
                                        </WrapPanel>
                                        <DataGrid x:Name="GrindSessGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240"
                                                  Background="#0C0F13" RowBackground="#0F141C" AlternatingRowBackground="#111A26"
                                                  Foreground="{StaticResource Text}" BorderBrush="#26405A" BorderThickness="1"
                                                  GridLinesVisibility="None" HeadersVisibility="Column" CanUserAddRows="False"
                                                  FontSize="11.5" ColumnHeaderHeight="26">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="When" Binding="{Binding When, StringFormat='{}{0:MMM d HH:mm}'}" Width="105" SortDirection="Descending"/>
                                                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="90"/>
                                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="130"/>
                                                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="75"/>
                                                <DataGridTextColumn Header="Kills" Binding="{Binding Kills}" Width="55"/>
                                                <DataGridTextColumn Header="XP" Binding="{Binding Xp}" Width="50"/>
                                                <DataGridTextColumn Header="AA" Binding="{Binding Aa}" Width="45"/>
                                                <DataGridTextColumn Header="Deaths" Binding="{Binding Deaths}" Width="60"/>
                                                <DataGridTextColumn Header="Dmg dealt" Binding="{Binding Dealt, StringFormat=N0}" Width="85"/>
                                                <DataGridTextColumn Header="Dmg taken" Binding="{Binding Taken, StringFormat=N0}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Background="#13243B" CornerRadius="6" Padding="10,6" Margin="0,4,0,0">
                                            <TextBlock x:Name="GrindSessTally" FontFamily="Consolas" FontSize="11.5" Foreground="#9FB6CC"
                                                       Text="no sessions yet"/>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== COMBAT (live DPS meter + per-fight parse from the log) ===== -->
                    <Grid x:Name="PanelCombat" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Combat Meter" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,3,0,0"
                                       Text="Reads your damage from the log in real time — melee, spells, DoTs, and damage shields (grammar ported from EQ Legends Companion). The chart is dealt vs. taken DPS over the last 10 minutes; below it, each fight is parsed out with its DPS, duration, max hit, and crits. Needs the log folder set on Log Reader."/>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CombatLiveLabel" Text="DPS — dealt vs taken" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <TextBlock x:Name="CombatTotals" Grid.Column="1" Text="" FontSize="11" Foreground="#9FB6CC" FontFamily="Consolas"/>
                                </Grid>
                                <charts:TimeSeriesChart x:Name="CombatChart" Height="150" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Text="FIGHTS (most recent first — click one to chart it)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="2,0,0,4"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <ListView x:Name="FightsList" Grid.Column="0" Margin="0,0,10,0" Background="#0C0F13" Foreground="#EAF6FF" BorderBrush="#26405A"
                                      SelectionChanged="Fight_Selected" VirtualizingPanel.IsVirtualizing="True" FontSize="12">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time" Width="74" DisplayMemberBinding="{Binding TimeText}"/>
                                        <GridViewColumn Header="Target" Width="170" DisplayMemberBinding="{Binding Target}"/>
                                        <GridViewColumn Header="Dur" Width="46" DisplayMemberBinding="{Binding DurText}"/>
                                        <GridViewColumn Header="Dmg" Width="70" DisplayMemberBinding="{Binding DmgDealt}"/>
                                        <GridViewColumn Header="DPS" Width="60" DisplayMemberBinding="{Binding DpsText}"/>
                                        <GridViewColumn Header="Max" Width="54" DisplayMemberBinding="{Binding MaxHit}"/>
                                        <GridViewColumn Header="Crit" Width="42" DisplayMemberBinding="{Binding Crits}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="FightTitle" Text="Pick a fight" FontSize="13" FontWeight="Bold" Foreground="#EAF6FF"/>
                                    <TextBlock x:Name="FightSub" Text="its damage-per-second is charted here" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,2,0,6"/>
                                    <charts:TimeSeriesChart x:Name="FightChart" Height="150"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===== SESSIONS (recorded role runs: stats, rates, settings, heatmap replay) ===== -->
                    <Grid x:Name="PanelSessions" Margin="18" Visibility="Collapsed">
                        <Grid.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="Background" Value="#121A28"/>
                                <Setter Property="Foreground" Value="#7FB2D9"/>
                                <Setter Property="BorderBrush" Value="#26405A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="8,5"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Session History" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,3,0,0"
                                       Text="Every role run records itself: duration, kills, XP ticks, AA points, the exact settings it ran with, and the travel trail. Click a column header to sort (click again to flip) — e.g. sort XP/h to find your best run, open it, and compare its settings against a slower one. XP has no amounts in the game's log, so XP is counted in ticks (gains); AA points are exact."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <ComboBox x:Name="SessRoleBox" Width="110" SelectedIndex="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                      SelectionChanged="SessFilter_Changed">
                                <ComboBoxItem Content="All roles"/><ComboBoxItem Content="Grind"/><ComboBoxItem Content="Hunt"/><ComboBoxItem Content="Follower"/>
                            </ComboBox>
                            <TextBox x:Name="SessFilterBox" Width="220" VerticalAlignment="Center" Margin="0,0,8,0"
                                     TextChanged="SessFilter_Changed" ToolTip="Filter by zone, role, or any setting value (e.g. 'oasis', 'rest s: 8')."/>
                            <Button Content="Refresh" Click="SessRefresh_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SessCount" Text="" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                        </WrapPanel>

                        <ListView x:Name="SessList" Grid.Row="2" Background="#0C0F13" Foreground="#EAF6FF" BorderBrush="#26405A"
                                  SelectionChanged="SessList_Selected" GridViewColumnHeader.Click="SessSort_Click"
                                  VirtualizingPanel.IsVirtualizing="True" FontSize="12">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="112" DisplayMemberBinding="{Binding DateText}"><GridViewColumn.Header><GridViewColumnHeader Content="Date" Tag="StartedAt"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="76" DisplayMemberBinding="{Binding Role}"><GridViewColumn.Header><GridViewColumnHeader Content="Role" Tag="Role"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="84" DisplayMemberBinding="{Binding DurationText}"><GridViewColumn.Header><GridViewColumnHeader Content="Duration" Tag="DurationSeconds"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding Actions}"><GridViewColumn.Header><GridViewColumnHeader Content="Actions" Tag="Actions"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="56" DisplayMemberBinding="{Binding Kills}"><GridViewColumn.Header><GridViewColumnHeader Content="Kills" Tag="Kills"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="56" DisplayMemberBinding="{Binding XpTicks}"><GridViewColumn.Header><GridViewColumnHeader Content="XP" Tag="XpTicks"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding XpRateText}"><GridViewColumn.Header><GridViewColumnHeader Content="XP/h" Tag="XpPerHour"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="50" DisplayMemberBinding="{Binding AaPoints}"><GridViewColumn.Header><GridViewColumnHeader Content="AA" Tag="AaPoints"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding AaRateText}"><GridViewColumn.Header><GridViewColumnHeader Content="AA/h" Tag="AaPerHour"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="66" DisplayMemberBinding="{Binding DpsText}"><GridViewColumn.Header><GridViewColumnHeader Content="DPS" Tag="Dps"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="70" DisplayMemberBinding="{Binding AssistsText}"><GridViewColumn.Header><GridViewColumnHeader Content="Assists" Tag="Assists"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="82" DisplayMemberBinding="{Binding CombatShareText}"><GridViewColumn.Header><GridViewColumnHeader Content="In combat" Tag="CombatShare"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="50" DisplayMemberBinding="{Binding Deaths}"><GridViewColumn.Header><GridViewColumnHeader Content="Deaths" Tag="Deaths"/></GridViewColumn.Header></GridViewColumn>
                                    <GridViewColumn Width="150" DisplayMemberBinding="{Binding PrimaryZone}"><GridViewColumn.Header><GridViewColumnHeader Content="Zone" Tag="PrimaryZone"/></GridViewColumn.Header></GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="3" Background="#0C0F13" BorderBrush="#26405A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0" MaxHeight="210">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock x:Name="SessDetailHint" Text="Select a session to see its settings, timeline chart, and heatmap." Foreground="{StaticResource TextDim}" FontSize="12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="SessDetail" Grid.Column="0"/>
                                        <charts:TimeSeriesChart x:Name="SessChart" Grid.Column="1" Height="150" VerticalAlignment="Top" Margin="8,4,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ===== GAME DATA (Companion catalogs: mobs, raid targets, PoSky, hunting guide) ===== -->
                    <Grid x:Name="PanelData" Margin="18" Visibility="Collapsed">
                        <Grid.Resources>
                            <Style x:Key="DataTab" TargetType="RadioButton">
                                <Setter Property="Foreground" Value="#9FB6CC"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="bd" CornerRadius="16" Padding="14,6" Background="#121A28" BorderBrush="#26405A" BorderThickness="1">
                                                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1B3A57"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4FC3F7"/>
                                                    <Setter Property="Foreground" Value="#EAF6FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Mobs" IsChecked="True" Checked="DataTab_Checked" Content="Mobs"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Raid" Checked="DataTab_Checked" Content="Raid Targets"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Sky" Checked="DataTab_Checked" Content="Plane of Sky"/>
                            <RadioButton Style="{StaticResource DataTab}" GroupName="datatab" Tag="Guide" Checked="DataTab_Checked" Content="Hunting Guide"/>
                        </StackPanel>
                        <TextBlock x:Name="DataStatus" Grid.Row="1" FontSize="11" Foreground="{StaticResource TextDim}" Margin="2,0,0,8" Text="opening…"/>

                        <Grid Grid.Row="2">
                            <!-- MOBS -->
                            <Grid x:Name="DataViewMobs">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBox x:Name="DataSearchBox" Width="320" VerticalAlignment="Center" Margin="0,0,10,0"
                                             TextChanged="DataSearch_Changed"
                                             ToolTip="Search 7,872 mobs by name, zone, or drop — e.g. 'guk ghoul', 'flowing black', 'oasis'."/>
                                    <TextBlock x:Name="MobsCount" Text="" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                </WrapPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
                                    <ListBox x:Name="MobsList" Grid.Column="0" Margin="0,0,10,0" Background="#0C0F13" BorderBrush="#26405A"
                                             SelectionChanged="MobsList_Selected" HorizontalContentAlignment="Stretch"
                                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="2,3">
                                                    <TextBlock Text="{Binding Name}" Foreground="#EAF6FF" FontSize="13"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LevelText}" Foreground="#7FB2D9" FontSize="11" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding ZonesText}" Foreground="#5D6878" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Column="1" Background="#0C0F13" BorderBrush="#26405A" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="MobDetail">
                                                <TextBlock Text="Pick a mob to see its levels, zones, and drops." Foreground="{StaticResource TextDim}" FontSize="12"/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Grid>
                            <!-- RAID -->
                            <ScrollViewer x:Name="DataViewRaid" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RaidHost" MaxWidth="640" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                            <!-- PLANE OF SKY -->
                            <Grid x:Name="DataViewSky" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Class" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="SkyClassBox" Width="160" SelectionChanged="SkyClass_Changed"/>
                                </WrapPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SkyHost" MaxWidth="720" HorizontalAlignment="Left"/>
                                </ScrollViewer>
                            </Grid>
                            <!-- HUNTING GUIDE -->
                            <Grid x:Name="DataViewGuide" Visibility="Collapsed">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Your level" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="GuideLevelBox" Width="52" VerticalAlignment="Center" TextChanged="GuideLevel_Changed" Text="50"/>
                                    <TextBlock Text="zones ranked by how many catalog mobs sit within −3…+2 of you (computed, not hand-curated)" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="11" Margin="10,0,0,0"/>
                                </WrapPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="GuideHost" MaxWidth="720" HorizontalAlignment="Left"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ===== MAPS (Companion-style zone maps: default + Brewall, heat overlay) ===== -->
                    <Grid x:Name="PanelMaps" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Zone" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsZoneBox" Width="230" IsEditable="True" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsZone_Selected" KeyDown="MapsZone_KeyDown"
                                      ToolTip="Pick a zone, or type its name (long names work: 'Nagafen's Lair' finds soldungb)."/>
                            <CheckBox x:Name="MapsFollowBox" Content="follow my zone" IsChecked="True" VerticalAlignment="Center"
                                      Foreground="{StaticResource TextDim}" Margin="0,0,14,6"
                                      ToolTip="Switch the map automatically when the log says you entered a new zone."/>
                            <TextBlock Text="geometry" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsGeoPackBox" Width="110" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsPack_Changed"
                                      ToolTip="Which pack draws the walls. Auto = the game's own maps (EQL-authoritative)."/>
                            <TextBlock Text="labels" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <ComboBox x:Name="MapsLabelPackBox" Width="110" VerticalAlignment="Center" Margin="0,0,10,6"
                                      SelectionChanged="MapsPack_Changed"
                                      ToolTip="Which pack supplies the labeled points. Auto = Brewall when installed (100× the labels)."/>
                            <TextBlock Text="EQ folder" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,6"/>
                            <TextBox x:Name="MapsEqRootBox" Width="150" VerticalAlignment="Center" Margin="0,0,4,6"
                                     ToolTip="Your EverQuest install folder (the one containing 'maps')."/>
                            <Button Content="Rescan" Click="MapsRescan_Click" Margin="0,0,0,6"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <CheckBox x:Name="MapsLabelsBox" Content="labels" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <CheckBox x:Name="MapsLegendBox" Content="legend" IsChecked="False" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,10,4"
                                      ToolTip="The pack's colour key + credits — drawn off-map by design, so it appears beside the zone."/>
                            <CheckBox x:Name="MapsExtraBox" Content="extra" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,14,4"
                                      ToolTip="The pack's third layer (_3 files), where one exists."/>
                            <CheckBox x:Name="MapsHeatBox" Content="heat" IsChecked="False" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,4"
                                      ToolTip="This session's /loc heatmap, drawn over the real zone walls."/>
                            <CheckBox x:Name="MapsTrailBox" Content="trail" IsChecked="True" Checked="MapsLayer_Changed" Unchecked="MapsLayer_Changed"
                                      Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,16,4"
                                      ToolTip="Your recent path, from live /loc."/>
                            <TextBlock Text="floor" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                            <Button x:Name="MapsFloorDown" Content="▼" Padding="8,3" Click="MapsFloorDown_Click" Margin="0,0,2,4"
                                    ToolTip="Step one floor down."/>
                            <Border Background="#13243B" CornerRadius="5" Padding="9,4" Margin="0,0,2,4" VerticalAlignment="Center">
                                <TextBlock x:Name="MapsFloorChip" Text="All levels" Foreground="#9FB6CC" FontSize="11.5"/>
                            </Border>
                            <Button x:Name="MapsFloorUp" Content="▲" Padding="8,3" Click="MapsFloorUp_Click" Margin="0,0,14,4"
                                    ToolTip="Step one floor up."/>
                            <Button Content="−" Padding="10,3" Click="MapsZoomOut_Click" Margin="0,0,2,4"/>
                            <Button Content="+" Padding="10,3" Click="MapsZoomIn_Click" Margin="0,0,2,4"/>
                            <Button Content="Fit" Click="MapsFit_Click" Margin="0,0,14,4"/>
                            <Button x:Name="MapsOverlayBtn" Content="Overlay in-game" Click="MapsOverlay_Click" Margin="0,0,2,4"
                                    ToolTip="Float THIS map (with heat/trail as toggled) over the game — transparent, always on top. The overlay's 'ghost' button makes it click-through."/>
                            <Button Content="Export PNG" Click="MapsExport_Click" Margin="0,0,14,4"
                                    ToolTip="Save the current map view (including the heat overlay) as a PNG to share."/>
                            <TextBlock Text="plan:" VerticalAlignment="Center" Foreground="{StaticResource Warn}" Margin="0,0,4,4"
                                       ToolTip="Draw this zone's hunting plan: a waypoint route and/or a hunting-zone shape. Saved per zone; the Grind role's Waypoints / Hunting Zone modes follow it."/>
                            <ToggleButton x:Name="EditWpBtn" Content="✎ waypoints" Padding="8,3" Margin="0,0,2,4" Checked="MapsEdit_Changed" Unchecked="MapsEdit_Changed"
                                          ToolTip="Click the map to drop numbered waypoints along the route you want patrolled."/>
                            <ToggleButton x:Name="EditCircleBtn" Content="◯" Padding="8,3" Margin="0,0,2,4" Checked="MapsEdit_Changed" Unchecked="MapsEdit_Changed"
                                          ToolTip="Hunting zone as a circle: click the CENTER, then click the EDGE."/>
                            <ToggleButton x:Name="EditRectBtn" Content="▭" Padding="8,3" Margin="0,0,2,4" Checked="MapsEdit_Changed" Unchecked="MapsEdit_Changed"
                                          ToolTip="Hunting zone as a rectangle: click two opposite corners."/>
                            <ToggleButton x:Name="EditPolyBtn" Content="⬠" Padding="8,3" Margin="0,0,2,4" Checked="MapsEdit_Changed" Unchecked="MapsEdit_Changed"
                                          ToolTip="Hunting zone as any shape: click each corner, then press 'close'."/>
                            <Button x:Name="EditPolyCloseBtn" Content="close" Padding="8,3" Margin="0,0,6,4" Visibility="Collapsed" Click="MapsPolyClose_Click"
                                    ToolTip="Close the polygon with the points placed so far (needs at least 3)."/>
                            <Button Content="↶ undo point" Padding="8,3" Margin="0,0,2,4" Click="MapsUndoWp_Click"
                                    ToolTip="Remove the last waypoint you placed. You can also right-click any waypoint on the map to remove that one — the rest renumber themselves."/>
                            <Button Content="clear route" Padding="8,3" Margin="0,0,2,4" Click="MapsClearWp_Click"
                                    ToolTip="Delete this zone's saved waypoints."/>
                            <Button Content="clear zone" Padding="8,3" Margin="0,0,6,4" Click="MapsClearShape_Click"
                                    ToolTip="Delete this zone's saved hunting-zone shape."/>
                            <TextBlock x:Name="MapsEditHint" Text="" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                        </WrapPanel>

                        <Border Grid.Row="2" CornerRadius="10" BorderBrush="#26405A" BorderThickness="1" ClipToBounds="True" Background="#0B121E">
                            <map:MapViewElement x:Name="MapsView"/>
                        </Border>

                        <TextBlock x:Name="MapsStatus" Grid.Row="3" Margin="2,6,0,0" FontSize="11"
                                   Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                   Text="Set your EQ folder and pick a zone."/>
                    </Grid>

                    <!-- ===== FOLLOWER (follow + assist a leader) ===== -->
                    <Grid x:Name="PanelFollower" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <Border x:Name="FollowerBanner" CornerRadius="8" Padding="12,9" Margin="0,0,0,8"
                                    Background="#20303F" BorderBrush="#2A4A57" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="FollowerBannerDot" Width="12" Height="12" Fill="#5D6878" Margin="0,0,11,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FollowerBannerText" Text="STOPPED — press Start follower" FontWeight="Bold" FontSize="14" Foreground="#C6D2DE" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                       Text="Group play: run THIS instance where your second character plays, enter the leader's exact name, and press Start. The follower types /target + /follow into chat itself (no in-game socials needed), re-follows on a timer so a lost follow self-heals, and — when the leader's swings or casts show up in the log — waits a human-ish beat, /assists, turns attack on, and runs your rotation until the mob drops or the fight goes quiet. Then attack off, a short rest, and back on the leash. EQL must be the focused window on this PC (tab away = instant pause) and F12 stops it. If the leader name has a space or title, use just the first name."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button Content="Target EverQuest" Click="FollowerTargetEq_Click"/>
                            <TextBlock x:Name="FollowerTargetLabel" Text="target: —" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontFamily="Consolas"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextDim}" Margin="0,0,0,3"
                                   Text="Assist rotation — one &quot;key,delayMs&quot; per line (keys: 0-9, A-Z, F1-F12, Tab, mouse1-5). Leave empty for auto-attack only:"/>
                        <TextBox x:Name="FollowerRotation" Grid.Row="3" AcceptsReturn="True" FontFamily="Consolas" FontSize="12"
                                 Background="#0C0F13" BorderBrush="{StaticResource AccentDim}"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="# key,delayMs  (e.g. your combat macro on 4)&#10;4,1400"/>

                        <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                            <Button Content="Start follower" Click="StartFollower_Click" Margin="0,0,8,8"/>
                            <Button Content="Stop (F12)" Click="StopFollower_Click" Margin="0,0,8,8"/>
                            <Button Content="Save settings" Click="SaveFollower_Click" Margin="0,0,16,8"/>
                            <CheckBox x:Name="FollowerAutoAssistBox" Content="auto-assist when the leader fights" IsChecked="True"
                                      Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="leader" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerLeaderBox" Text="" Width="110" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="The character to follow — exact first name, e.g. Bryari."/>
                            <TextBlock Text="re-follow s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerRefollowBox" Text="40" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Re-issue /target + /follow this often while idle, so a lost follow self-heals."/>
                            <TextBlock Text="assist delay ms" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerAssistDelayBox" Text="900" Width="52" VerticalAlignment="Center" Margin="0,0,8,8"
                                     ToolTip="Human-ish pause between the leader engaging and this character joining in."/>
                            <TextBlock Text="max fight s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerMaxFightBox" Text="30" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <TextBlock Text="rest s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,3,8"/>
                            <TextBox x:Name="FollowerRestBox" Text="4" Width="40" VerticalAlignment="Center" Margin="0,0,8,8"/>
                        </WrapPanel>

                        <TextBlock x:Name="FollowerStatsLabel" Grid.Row="5" Margin="0,4,0,4" FontFamily="Consolas"
                                   Foreground="{StaticResource Text}" Text="idle — assists 0 · kills 0 · re-follows 0"/>

                        <TextBox x:Name="FollowerLog" Grid.Row="6" Height="96" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== AUTO-LOGIN ===== -->
                    <Grid x:Name="PanelLogin" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="Login Console" FontSize="18" FontWeight="Bold" Foreground="#EAF6FF"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,0"
                                       Text="This is the log for the one-click Launch on Command Center. It reads each launch screen with Windows OCR and clicks it: the green PLAY on LaunchPad, your server + PLAY on server-select, then 'Enter World' at character select. Every string OCR sees is printed here, so if a click is missed you can tell me exactly what it read. Set the launcher path once and Launch can start the game for you too."/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <TextBox x:Name="LoginServerBox" Text="Rivervale" Width="150" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Launcher:" VerticalAlignment="Center" Margin="0,0,6,8"/>
                            <TextBox x:Name="LauncherPathBox" Text="" Width="240" VerticalAlignment="Center" Margin="0,0,6,8"
                                     ToolTip="Path to the EQL launcher exe (optional). If set, Launch starts it before auto-login."/>
                            <Button Content="Browse…" Click="PickLauncher_Click" Margin="0,0,12,8"/>
                            <Button Content="Start auto-login" Click="StartLogin_Click" Margin="0,0,8,8"/>
                            <Button Content="Stop" Click="StopLogin_Click" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <TextBox x:Name="LoginLog" Grid.Row="2" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== MOUSE ===== -->
                    <Grid x:Name="PanelMouse" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"
                                   Text="Fluid, varied cursor motion for the foreground automation: cosine ease-in-out for acceleration, a sine arc so the path curves, plus run-to-run randomness in speed, curve, and launch angle (timing uses your global variance %). The demo moves your REAL cursor around the screen so you can watch it — click Stop or press F12 to halt, and just move your mouse yourself to take back over."/>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Speed px/s:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseSpeedBox" Text="900" Width="64" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Arc:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseArcBox" Text="0.12" Width="54" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <TextBlock Text="Angle jitter°:" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBox x:Name="MouseAngleBox" Text="6" Width="48" VerticalAlignment="Center" Margin="0,0,12,8"/>
                            <Button Content="Apply &amp; save" Click="ApplyMouse_Click"/>
                        </WrapPanel>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                            <Button Content="Start fluid demo" Click="StartMouseDemo_Click"/>
                            <Button Content="Stop (F12)" Click="StopMouseDemo_Click"/>
                        </WrapPanel>

                        <TextBox x:Name="MouseLog" Grid.Row="3" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== LICENSING ===== -->
                    <Grid x:Name="PanelLicensing" Margin="18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"
                                   Text="This install checks in to the central Client Hub: it reports who's running, on what tier, and what they're doing (actions, kills, xp, session time) to the shared dashboard. The hub answers with your tier and the roles it unlocks. Nothing here changes the game — it's the licensing + usage-reporting layer. Check-ins send only counts and your chosen name."/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Check in as" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LicUserBox" Margin="0,0,10,6"
                                       ToolTip="Your character or account name — this is what shows on the dashboard."/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Machine" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="LicMachineLabel" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDim}" FontFamily="Consolas" Margin="0,0,0,6" Text="—"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Hub URL" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicUrlBox" Margin="0,0,0,6"
                                       FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="API key" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicKeyBox" Margin="0,0,0,6"
                                       FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Character" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="LicCharText" Margin="0,0,0,6"
                                       VerticalAlignment="Center" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="12"
                                       Text="— set up on the Profile page"/>
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,4,0,10">
                            <Button Content="Check in now" Click="CheckInNow_Click"/>
                            <Button Content="Save" Click="SaveLicensing_Click"/>
                            <Button Content="Open dashboard" Click="OpenDashboard_Click"/>
                            <CheckBox x:Name="LicAutoBox" Content="auto check-in every" Foreground="{StaticResource TextDim}"
                                      VerticalAlignment="Center" Margin="8,0,6,8" Click="LicAuto_Click"/>
                            <TextBox x:Name="LicIntervalBox" Text="120" Width="52" VerticalAlignment="Center" Margin="0,0,4,8"/>
                            <TextBlock Text="s" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentDim}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" x:Name="LicTierBadge" CornerRadius="20" Padding="16,8"
                                        Background="#20303F" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="LicTierText" Text="not checked in" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource Text}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LicStatusText" Text="Set a name and click “Check in now”."
                                               Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="LicRolesText" Text="roles: —" Foreground="{StaticResource TextDim}"
                                               FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="LicLastText" Text="last check-in: never" Foreground="{StaticResource TextDim}"
                                               FontSize="12" Margin="0,1,0,0"/>
                                    <TextBlock x:Name="LicSessionText" Text="reporting: role Idle · actions 0 · kills 0 · xp 0"
                                               Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="LAST 10 CONNECTIONS" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                    <Button Grid.Column="1" Content="Refresh" Click="ConnRefresh_Click" Padding="10,2"/>
                                </Grid>
                                <ListView x:Name="ConnList" Height="152" Margin="0,8,0,0" Background="#0C0F13" Foreground="#EAF6FF"
                                          BorderBrush="#26405A" FontSize="12" VirtualizingPanel.IsVirtualizing="True">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="When" Width="108" DisplayMemberBinding="{Binding WhenText}"/>
                                            <GridViewColumn Header="Duration" Width="72" DisplayMemberBinding="{Binding DurText}"/>
                                            <GridViewColumn Header="Roles" Width="150" DisplayMemberBinding="{Binding RolesText}"/>
                                            <GridViewColumn Header="Actions" Width="68" DisplayMemberBinding="{Binding ActionsText}"/>
                                            <GridViewColumn Header="Kills" Width="54" DisplayMemberBinding="{Binding KillsText}"/>
                                            <GridViewColumn Header="XP" Width="74" DisplayMemberBinding="{Binding XpText}"/>
                                            <GridViewColumn Header="From" Width="104" DisplayMemberBinding="{Binding FromText}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock x:Name="ConnHint" Text="What this install did on the hub — sessions, roles used, and totals. Refreshes after each check-in."
                                           Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="LicLog" Grid.Row="6" IsReadOnly="True"
                                 Background="#0C0F13" Foreground="{StaticResource Good}" FontFamily="Consolas" FontSize="11"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- ===== KEY MAPPINGS (OCR mirror of the game’s Controls → Key binds) ===== -->
                    <Grid x:Name="PanelKeymaps" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14,18,26">
                                <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                                    <Image x:Name="ArtKeymapsBanner" Stretch="Uniform"/>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="KEY MAPPINGS" FontWeight="Bold" FontSize="15" Foreground="#BFE3FF" VerticalAlignment="Center"/>
                                        <Border x:Name="KmStampBorder" Background="#2A2410" BorderBrush="#7A6320" BorderThickness="1" CornerRadius="6"
                                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                ToolTip="When the mappings were last read from the game. Recapture after you rebind keys in-game.">
                                            <TextBlock x:Name="KmStampText" Text="never captured" FontSize="10.5" Foreground="#FFE1A6"/>
                                        </Border>
                                        <Border Background="#16202E" BorderBrush="#2A4A57" BorderThickness="1" CornerRadius="999"
                                                Width="22" Height="22" Cursor="Hand" MouseLeftButtonUp="KmInfo_Click" Margin="10,0,0,0"
                                                ToolTip="How capturing, filtering, locking and sharing key mappings works — the full guide.">
                                            <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="13"
                                                       Foreground="#7FB2D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="KmAutoBtn" Content="⟳  Auto-capture everything" Click="KmAuto_Click" Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"
                                                ToolTip="Hands-free: brings EQ forward, reads the visible binds, scrolls the list itself and keeps reading until nothing new turns up. Open Controls → Key binds with category ALL first."/>
                                        <Button x:Name="KmCaptureBtn" Content="◉  Capture page" Click="KmCapture_Click" Padding="12,6" Margin="0,0,8,0"
                                                ToolTip="Read just what's on screen right now — handy for topping up one stubborn section."/>
                                        <Button Content="Share ↗" Click="KmShare_Click" Padding="12,6" Margin="0,0,8,0"
                                                ToolTip="Publish these mappings to your member page so friends can view them (and copy them) from the website."/>
                                        <Button Content="Clear all" Click="KmClear_Click" Padding="10,6" Margin="0"
                                                ToolTip="Forget every mapping and the refresh stamp."/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="KmCountText" Text="" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="1,0,0,8"/>

                                <Border Background="#121A28" BorderBrush="#26405A" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#9FB6CC"
                                                   Text="① In EQL open Options → Controls → Key binds and set the category to ALL   ② keep that window fully visible   ③ press ⟳ Auto-capture everything — the bot scrolls and reads the whole list for you."/>
                                        <TextBlock x:Name="KmStatus" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="#7CE38B" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- IMPORT: pull a friend's published binds straight from their shared page -->
                                <Expander x:Name="KmImportExpander" Foreground="#DDE7F0" Margin="0,0,0,10">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="IMPORT FROM A FRIEND" FontWeight="Bold" FontSize="11" Foreground="#7FB2D9" VerticalAlignment="Center"/>
                                            <TextBlock Text="paste their shared Key Mappings link — locked binds of yours are never touched"
                                                       FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border Background="#121A28" BorderBrush="#26405A" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10" Margin="0,6,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="KmImportUrl" Width="520" FontSize="11.5" Margin="0,0,8,0"
                                                         ToolTip="The link from a friend's shared Key Mappings page, e.g. https://eqavatar.ldtlan.com/hub/keymaps.php?u=NAME&amp;share=TOKEN — the app only ever reads through that share link, never from a file or any other site."/>
                                                <Button Content="Fetch" Click="KmFetch_Click" Padding="14,5" Margin="0,0,8,0"
                                                        ToolTip="Read their published binds and show exactly what differs from yours."/>
                                                <Button x:Name="KmApplyBtn" Content="Apply in game" Click="KmApply_Click" Padding="14,5" Margin="0"
                                                        Visibility="Collapsed" FontWeight="SemiBold"
                                                        ToolTip="Walks the game's Key binds screen and sets each ticked bind: clicks the cell, presses the key, then re-reads the row to confirm it took."/>
                                            </StackPanel>
                                            <TextBlock x:Name="KmImportStatus" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="#9FE0FF" Margin="0,8,0,0"/>
                                            <StackPanel x:Name="KmDiffHost" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <!-- column titles: a scene per column with its name underneath, then that column's own filter -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="176"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="2,0,8,0"
                                                ToolTip="Every action your game can bind, exactly as its Controls screen names it. Sequencer ACTION pills resolve through this list.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtKmColAction" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="ACTION" FontWeight="Bold" FontSize="10.5" Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="KmFilterAction" TextChanged="KmFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Type any part of an action name — the list narrows instantly."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,4,0"
                                                ToolTip="The main key or mouse button bound to each action.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtKmColPrimary" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="PRIMARY" FontWeight="Bold" FontSize="10.5" Foreground="#9FE0FF" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="KmFilterPrimary" TextChanged="KmFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Filter by primary key — type 'mouse' to see every mouse binding, 'F' for function keys, 'shift' for modifiers. Type '—' to find unbound actions."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="4,0,4,0"
                                                ToolTip="The secondary (alternate) key or mouse button, when the action has one.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtKmColSecondary" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="SECONDARY" FontWeight="Bold" FontSize="10.5" Foreground="#C792EA" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="KmFilterAlt" TextChanged="KmFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Filter by secondary key. Type '—' to find actions with no secondary binding."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="4,0,4,0"
                                                ToolTip="Locked binds are protected: importing a friend's mappings will never overwrite them.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtKmColLock" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="LOCK" FontWeight="Bold" FontSize="10.5" Foreground="#FFCB6B" HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="KmLockedOnly" Content="only" FontSize="10.5" Foreground="#9FB6CC" Margin="0,6,0,0"
                                                  HorizontalAlignment="Center" Click="KmFilter_Click"
                                                  ToolTip="Show only the binds you've locked."/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="KmListHost"/>

                                <Border Background="#121A28" BorderBrush="#26405A" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ADD OR FIX A BIND BY HAND" FontSize="9.5" FontWeight="Bold" Foreground="#5E7C9A" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="KmAddAction" Width="220" FontSize="11.5" Margin="0,0,6,0" ToolTip="Action name (e.g. Jump)"/>
                                            <TextBox x:Name="KmAddPrimary" Width="90" FontSize="11.5" Margin="0,0,6,0" ToolTip="Primary key (e.g. Space)"/>
                                            <TextBox x:Name="KmAddAlt" Width="90" FontSize="11.5" Margin="0,0,6,0" ToolTip="Secondary key (optional)"/>
                                            <Button Content="＋ add" Click="KmAdd_Click" Padding="10,3" Margin="0"
                                                    ToolTip="Add or fix a mapping by hand — merges by action name, just like a capture."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== ACTION SEQUENCER (visual sequence builder — engine lands with Key Mappings) ===== -->
                    <Grid x:Name="PanelSequencer" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14,18,26">
                                <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                                    <Image x:Name="ArtSeqBanner" Stretch="Uniform"/>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ACTION SEQUENCER" FontWeight="Bold" FontSize="15" Foreground="#BFE3FF" VerticalAlignment="Center"/>
                                        <Border Background="#16202E" BorderBrush="#2A4A57" BorderThickness="1" CornerRadius="999"
                                                Width="22" Height="22" Cursor="Hand" MouseLeftButtonUp="SeqInfo_Click" Margin="10,0,0,0"
                                                ToolTip="How sequences work — numbers, columns, pills, multi-part + revert. The full guide.">
                                            <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="13"
                                                       Foreground="#7FB2D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Content="＋  New sequence" Click="SeqNew_Click" Padding="14,6" Margin="0"
                                            FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            ToolTip="Add an empty sequence at the end of the list — it takes the next number."/>
                                </Grid>
                                <TextBlock x:Name="SeqCountText" Text="" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="1,0,0,12"/>

                                <!-- column titles: each its own scene, not a table header -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                ToolTip="The sequence number is its POSITION — always 1..N. Drag a medallion to reorder; drag #3 to the 8th spot and it becomes #8. Other pages reference sequences by this number.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="58" Margin="2,0,2,3">
                                            <Image x:Name="ArtSeqColId" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="SEQ" FontWeight="Bold" FontSize="10.5" Foreground="#9FE0FF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                ToolTip="General actions — jump, sit, target nearest NPC, open inventory. Each fires the key your game has bound to it; the Key Mappings page (Information section) will read those bindings straight from the game.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="58" Margin="4,0,4,3">
                                            <Image x:Name="ArtSeqColAction" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="ACTIONS" FontWeight="Bold" FontSize="10.5" Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                ToolTip="Physical stances AND invocations — each part of a sequence carries one of each; adding another replaces it.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="58" Margin="4,0,4,3">
                                            <Image x:Name="ArtSeqColStance" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="STANCES" FontWeight="Bold" FontSize="10.5" Foreground="#C792EA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3"
                                                ToolTip="Spell work — CAST a spell, MEM a single spell, or swap the whole set with /memspellset 'name'. The engine will know your spell slots and their contents.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="58" Margin="4,0,4,3">
                                            <Image x:Name="ArtSeqColSpell" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="SPELLS" FontWeight="Bold" FontSize="10.5" Foreground="#82AAFF" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4"
                                                ToolTip="Activated abilities — they run AFTER spells, so Quick Buff finds the right spells already memorized.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="58" Margin="4,0,4,3">
                                            <Image x:Name="ArtSeqColAbility" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="ABILITIES" FontWeight="Bold" FontSize="10.5" Foreground="#FFCB6B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="SeqListHost"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="#16202E" BorderBrush="#2A4A57" BorderThickness="1" CornerRadius="999"
                                            Width="22" Height="22" Cursor="Hand" MouseLeftButtonUp="SeqInfo_Click"
                                            ToolTip="Open the full sequencer guide.">
                                        <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="13"
                                                   Foreground="#7FB2D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                    </Border>
                                    <TextBlock Text="hover any title or pill for help — the engine that RUNS sequences ships with the Key Mappings page"
                                               FontSize="10.5" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== QUESTING (the wiki's quest catalog + per-quest turn-in automation) ===== -->
                    <Grid x:Name="PanelQuesting" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14,18,26">
                                <Border CornerRadius="12" ClipToBounds="True" Margin="0,0,0,12">
                                    <Image x:Name="ArtQuestingBanner" Stretch="Uniform"/>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="QUESTING" FontWeight="Bold" FontSize="15" Foreground="#BFE3FF" VerticalAlignment="Center"/>
                                        <Border x:Name="QstStampBorder" Background="#2A2410" BorderBrush="#7A6320" BorderThickness="1" CornerRadius="6"
                                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                ToolTip="When this quest catalog was last built from the wiki. Refresh pulls a newer build if there is one.">
                                            <TextBlock x:Name="QstStampText" Text="not loaded yet" FontSize="10.5" Foreground="#FFE1A6"/>
                                        </Border>
                                        <Border Background="#16202E" BorderBrush="#2A4A57" BorderThickness="1" CornerRadius="999"
                                                Width="22" Height="22" Cursor="Hand" MouseLeftButtonUp="QstInfo_Click" Margin="10,0,0,0"
                                                ToolTip="Where this data comes from, what the columns mean, and how a turn-in is automated — the full guide.">
                                            <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="13"
                                                       Foreground="#7FB2D9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="QstRefreshBtn" Content="⟳  Refresh from hub" Click="QstRefresh_Click" Padding="14,6" FontWeight="SemiBold" Margin="0,0,8,0"
                                                ToolTip="Check the hub for a newer catalog build. Only downloads when the published build differs from the one cached here."/>
                                        <Button Content="Clear filters" Click="QstClear_Click" Padding="10,6" Margin="0"
                                                ToolTip="Reset every column filter."/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="QstCountText" Text="" FontSize="10.5" Foreground="{StaticResource TextDim}" Margin="1,0,0,8"/>

                                <Border Background="#121A28" BorderBrush="#26405A" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="QstHelpText" TextWrapping="Wrap" FontSize="11.5" Foreground="#9FB6CC"
                                                   Text="Every quest on the EQL wiki, parsed into rows. Filter by column, click a quest to open it — and where a quest ends in handing an item to an NPC, build an automation for that hand-in and let her repeat it."/>
                                        <TextBlock x:Name="QstStatus" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="#7CE38B" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- column titles: a scene per column with its name underneath, then that column's own filter -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="94"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="2,0,6,0"
                                                ToolTip="The quest's name, exactly as the wiki titles its page. Click any row to open the full walkthrough details.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColQuest" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="QUEST" FontWeight="Bold" FontSize="10.5" Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="QstFilterName" TextChanged="QstFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Type any part of a quest name — the list narrows instantly."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="3,0,3,0"
                                                ToolTip="The zone the quest is picked up in. The dropdown lists every zone that actually appears in the catalog.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColZone" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="START ZONE" FontWeight="Bold" FontSize="10.5" Foreground="#9FE0FF" HorizontalAlignment="Center"/>
                                        <ComboBox x:Name="QstFilterStartZone" SelectionChanged="QstFilterSel_Changed" FontSize="11" Margin="0,4,0,0"
                                                  ToolTip="Pick a zone to see only the quests that start there."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="3,0,3,0"
                                                ToolTip="The NPC who gives the quest out.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColStartNpc" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="START NPC" FontWeight="Bold" FontSize="10.5" Foreground="#C792EA" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="QstFilterStartNpc" TextChanged="QstFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Filter by quest giver."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="3,0,3,0"
                                                ToolTip="Who the quest is finished with — the hand-in NPC, and the zone they stand in.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColEndNpc" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="END NPC" FontWeight="Bold" FontSize="10.5" Foreground="#FFCB6B" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="QstFilterEndNpc" TextChanged="QstFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Filter by the NPC you hand the quest in to."/>
                                        <ComboBox x:Name="QstFilterEndZone" SelectionChanged="QstFilterSel_Changed" FontSize="11" Margin="0,3,0,0"
                                                  ToolTip="Filter by the zone the quest ENDS in — useful when the hand-in is somewhere other than where you picked it up."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Margin="3,0,3,0"
                                                ToolTip="The minimum level the wiki lists for the quest.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColLevel" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="LEVEL" FontWeight="Bold" FontSize="10.5" Foreground="#7CE38B" HorizontalAlignment="Center"/>
                                        <ComboBox x:Name="QstFilterLevel" SelectionChanged="QstFilterSel_Changed" FontSize="11" Margin="0,4,0,0"
                                                  ToolTip="Show only quests whose minimum level falls in this band."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" Margin="3,0,3,0"
                                                ToolTip="What the quest pays out — items, and the experience the wiki recorded.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColReward" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="REWARD" FontWeight="Bold" FontSize="10.5" Foreground="#FFB3D9" HorizontalAlignment="Center"/>
                                        <TextBox x:Name="QstFilterReward" TextChanged="QstFilter_Changed" FontSize="11.5" Margin="0,4,0,0"
                                                 ToolTip="Filter by reward — type part of an item name, or '—' to find quests with no item reward listed."/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" Margin="3,0,2,0"
                                                ToolTip="Whether this quest ends in a hand-in she can repeat for you, and whether you've built that automation yet.">
                                        <Border CornerRadius="9" ClipToBounds="True" Height="66" Margin="0,0,0,3">
                                            <Image x:Name="ArtQColAuto" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="AUTO" FontWeight="Bold" FontSize="10.5" Foreground="#FF8A65" HorizontalAlignment="Center"/>
                                        <CheckBox x:Name="QstAutoOnly" Content="only" FontSize="10.5" Foreground="#9FB6CC" Margin="0,6,0,0"
                                                  HorizontalAlignment="Center" Click="QstFilter_Click"
                                                  ToolTip="Show only quests whose hand-in can be automated."/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="QstListHost"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== PROFILE (character identity + sheet OCR) ===== -->
                    <Grid x:Name="PanelProfile" Margin="18" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentDim}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="ProfName" Text="—" FontSize="22" FontWeight="Bold" Foreground="#EAF6FF"/>
                                                <TextBlock x:Name="ProfSub" Text="set your character below" Foreground="{StaticResource TextDim}" FontSize="12.5" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#10233A" BorderBrush="#4FC3F7" BorderThickness="1.2" CornerRadius="999" Padding="12,5" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="CURRENT " FontSize="10" Foreground="#9FD8FF" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ProfCurLvl" Text="Lv 1" FontSize="13" FontWeight="Bold" Foreground="#EAF6FF"
                                                                   ToolTip="Level with your CURRENT class combination — changing classes resets this to 10."/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#241C33" BorderBrush="#C77DFF" BorderThickness="1.2" CornerRadius="999" Padding="12,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="BEST " FontSize="10" Foreground="#E3C6FF" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="ProfBestLvl" Text="Lv 1" FontSize="13" FontWeight="Bold" Foreground="#F4EAFF"
                                                                   ToolTip="Highest level ever reached on this account — never goes down, even when a class change resets you to 10."/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <WrapPanel Margin="0,12,0,0">
                                            <ComboBox x:Name="LicClassCombo" Width="150" VerticalAlignment="Center" Margin="0,0,8,4"
                                                      ToolTip="Your character's class combination — drives the web armory stats and color."/>
                                            <TextBlock Text="Lv" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                            <TextBox x:Name="LicLevelBox" Text="1" Width="46" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                            <ComboBox x:Name="LicRaceCombo" Width="130" VerticalAlignment="Center" Margin="0,0,8,4"/>
                                            <TextBlock Text="Server" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" Margin="0,0,4,4"/>
                                            <TextBox x:Name="LicServerBox" Text="Rivervale" Width="120" VerticalAlignment="Center" Margin="0,0,12,4"/>
                                            <Button Content="Save" Click="SaveLicensing_Click" Margin="0,0,8,4"/>
                                            <Button Content="Open web armory →" Click="OpenArmory_Click" Margin="0,0,0,4"
                                                    ToolTip="Your public character page on eqavatar.ldtlan.com."/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="These fields fill themselves from the character-sheet reads below — the app keeps them (and your best-ever level) up to date as it plays."/>
                                    </StackPanel>
                                </Border>

                                <!-- Character Sheet OCR: read the in-game Inventory window, no manual entry -->
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource AccentDim}"
                                        BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="CHARACTER SHEET — READ FROM THE GAME" FontSize="11" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,4,0,8"
                                                   Text="Open your Inventory in-game (Equipment tab), leave it visible, and press Read. The app captures the game window, finds the sheet by its own labels, and reads vitals, attributes, resists, regens, weight, coin, and your name/level/class — the real numbers, straight off the screen. Then send them to your web profile."/>
                                        <WrapPanel>
                                            <Button Content="Read inventory now" Click="OcrRead_Click" FontWeight="SemiBold" Margin="0,0,8,6"/>
                                            <CheckBox x:Name="OcrAutoBox" Content="auto-scan" Click="OcrAuto_Click" VerticalAlignment="Center" Margin="0,0,8,6"
                                                      Foreground="{StaticResource Text}"
                                                      ToolTip="Keeps watching the game every few seconds and reads the sheet automatically whenever the inventory is open — no button pressing. Sends to your profile at most every 10 minutes."/>
                                            <Button x:Name="OcrSendBtn" Content="Send to profile" Click="OcrSend_Click" IsEnabled="False" Margin="0,0,8,6"/>
                                            <TextBlock x:Name="OcrStatus" Text="no read yet" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,6"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="OcrSummary" FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource Text}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" Text=""/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== SETTINGS ===== -->
                    <Grid x:Name="PanelSettings" Margin="22" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left">
                                <TextBlock Text="Settings" FontSize="19" FontWeight="Bold"/>
                                <TextBlock Text="Global settings for the whole app. Per-module settings live on each panel and will migrate here over time." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,3,0,14"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="APPEARANCE" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Tooltip opacity" VerticalAlignment="Center" ToolTip="How see-through the light-blue tooltips are. This is one of the new custom tooltips!"/>
                                            <Slider x:Name="TooltipOpacitySlider" Grid.Column="1" Minimum="0.5" Maximum="1.0" SmallChange="0.05" TickFrequency="0.05"
                                                    VerticalAlignment="Center" Margin="8,0" ValueChanged="TooltipOpacity_Changed"/>
                                            <TextBlock x:Name="TooltipOpacityVal" Grid.Column="2" Text="92%" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextDim}"/>
                                        </Grid>
                                        <CheckBox x:Name="SettingsTopmostBox" Content="Keep the window on top of everything" Foreground="{StaticResource TextDim}"
                                                  Margin="0,10,0,0" Click="SettingsTopmost_Click"
                                                  ToolTip="On a two-monitor setup this floats the app over other apps and the game."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="AUTOMATION" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,10"/>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Timing variance %" VerticalAlignment="Center" ToolTip="Random +/- applied to every timed action so nothing looks metronomic."/>
                                            <TextBox x:Name="VarianceBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Pause on /tell (minutes)" VerticalAlignment="Center" ToolTip="Hold automation for this long when someone sends you a /tell."/>
                                            <TextBox x:Name="TellPauseBox" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <WrapPanel Margin="6,10,0,0">
                                    <Button Content="Save settings" Click="SaveSettings_Click"/>
                                    <Button Content="Check for updates" Click="CheckUpdates_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
