<Window x:Class="EQAvatar.Spike.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#0B0F16"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="960" Height="740" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel x:Name="Stage" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Width="420" Height="420"
                   Source="pack://application:,,,/assets/eqavatar-512.png"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="EQ  AVATAR" HorizontalAlignment="Center" Margin="0,4,0,0"
                       Foreground="#E6EDF3" FontSize="24" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
