<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10 TFM unlocks the built-in Windows.Media.Ocr engine for the auto-login. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>EQAvatar.Spike</AssemblyName>
    <!-- Local-build default only. CI overrides this with -p:Version=<tag> so a release build's
         reported version always equals the tag it was built from. -->
    <Version>0.9.37</Version>
    <RootNamespace>EQAvatar.Spike</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>EQAvatar.ico</ApplicationIcon>
    <!-- Lets the net8.0 build run on a newer installed runtime (9/10) too. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game's own animated class emblems, lifted from the client's A_ClassAnim01..16 and
         laid into one horizontal strip per class. Embedded rather than served from the hub:
         class art is fixed game data, and the loadout menu should not need the network to draw. -->
    <Resource Include="assets\class\*.png" />
    <Resource Include="assets\class\class-anims.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rescue tool is its own tiny project — keep its sources out of the app build. -->
    <Compile Remove="Rescue\**" />
    <None Remove="Rescue\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\eqavatar-512.png" />
    <Resource Include="assets\mascot.jpg" />
    <Resource Include="assets\data\mobs.json.gz" />
    <Resource Include="assets\data\bosses.json.gz" />
    <Resource Include="assets\data\posky.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrintWindow capture feeds the OCR engine. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
